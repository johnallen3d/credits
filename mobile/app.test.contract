test "a stale season with unreadable watched marks says both"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"tv","id":1396,"name":"Breaking Bad","year":"2008","image_url":null}]}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396" with 200 {"kind":"tv","id":1396,"title":"Breaking Bad","tagline":null,"overview":null,"year":"2008","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"state":"fresh","unavailable_reason":null,"preferred":null,"fetched_at":null},"cast":[],"season_list":[{"number":1,"name":"Season 1","year":"2008","episode_count":1}],"marks":{"to_watch":false,"favorite":false,"watched":false},"metadata":{"state":"fresh","fetched_at":"2026-11-16T08:00:00Z"}}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396/season/1" with 200 {"show_title":"Breaking Bad","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Pilot","air_date":null,"overview":"A teacher turns.","still_url":null}],"watched":{"state":"unreadable","show":false,"seasons":[],"episodes":[]},"metadata":{"state":"stale","fetched_at":"2026-10-16T08:00:00Z"}}
  tap "recent-tv-1396"
  tap "season-1"
  expect text "season-title" == "Breaking Bad: Season 1"
  expect tree has "stale"
  expect text "watched-note" == "Watched marks couldn’t be read, so every episode stays blurred."

test "tapping an episode in a season opens its screen"
  at "/tv/1396/season/1"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/tv/1396/season/1" with 200 {"show_title":"Breaking Bad","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Pilot","air_date":"2008-01-20","overview":"A teacher turns.","still_url":null}],"watched":{"state":"read","show":false,"seasons":[],"episodes":[]}}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396/season/1/episode/1" with 200 {"show_title":"Breaking Bad","season_number":1,"season_name":"Season 1","number":1,"title":"Pilot","air_date":"2008-01-20","overview":"A teacher turns.","runtime_minutes":59,"still_url":null,"rating":{"source":"imdb","score":9.0,"scale":10},"episode_ratings":{"state":"fresh","unavailable_reason":null},"key_crew":[{"role":"director","people":[{"person_id":66633,"name":"Vince Gilligan","role":"Director","profile_url":null}]}],"cast":[{"person_id":17419,"name":"Bryan Cranston","role":"Walter White","profile_url":null}],"guest_stars":[],"previous":null,"next":2,"watched":{"state":"read","show":false,"seasons":[],"episodes":[]}}
  tap "episode-open-1"
  expect text "episode-title" == "Pilot"
  expect text "facts" == "Jan 20, 2008 · 59 min"
  expect text "episode-score" == "IMDb 9"
  expect tree has "next"
  expect tree missing "previous"
  expect tree missing "watched"

