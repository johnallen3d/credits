test "a person's credits hold Favorite when Favorites can't be read, and say when a mark fails"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  answer fetch "https://credits.jallen7usa.com/api/watchlist?sort=added" with 200 {"titles":[]}
  fail fetch "https://credits.jallen7usa.com/api/favorites?sort=added"
  fail fetch "https://credits.jallen7usa.com/api/movie/603/watchlist"
  answer fetch "https://credits.jallen7usa.com/api/person/6384?sort=date" with 200 {"id":6384,"name":"Keanu Reeves","known_for_titles":[],"filmography":[{"department":"Acting","entries":[{"kind":"movie","id":603,"title":"The Matrix","year":"1999","role":"Neo"}]}],"sort":"date"}
  tap "recent-person-6384"
  clock data
  clock settle
  expect disabled "Acting-movie-603-favorite"
  expect enabled "Acting-movie-603-to-watch"
  expect text "marks-unread" == "Favorites couldn’t be read yet, so its buttons wait."
  tap "Acting-movie-603-to-watch"
  clock data
  clock settle
  expect tree has "credit-mark-error"

