  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/playback" with 200 {"live":{"state":"disconnected","since":"2026-11-16T14:46:31Z","error":"connection refused"},"status":{"state":"failed","at":"2026-11-16T14:46:31Z","error":"timed out","last_ok":null},"players":[],"pending":[],"recent":[{"player":"media_player.living_room","app":"infuse","item_key":"dark matter|1|1","kind":"episode","show_key":"dark matter","show_title":"Dark Matter","title":"Dark Matter - S1 E1","season":1,"episode":1,"duration":2920,"playing_seconds":2700,"max_position":null,"last_seen":"2026-11-16T14:46:31Z","status":"marked","tmdb_id":196322,"note":null}],"other":[],"unreadable":true}
  expect text "playback-live" == "Disconnected from Home Assistant: connection refused. Retrying; meanwhile its history is read at least every 5 minutes."
  expect text "playback-sync" == "Couldn’t read Home Assistant’s history: timed out. Episodes and movies already played are still marked."
  expect tree has "playback-unreadable"
  expect tree has "played-dark matter|1|1"

