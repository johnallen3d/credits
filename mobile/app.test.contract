  clock settle
  expect text "saved-movie-1-notes" == "#Sam · On Netflix"
  expect text "list-notes" == "Couldn’t check where 1 title is available right now."
  type "list-services" "mine"
  expect tree has "saved-movie-1"
  expect tree missing "saved-tv-2"
  expect tree missing "saved-movie-3"
  expect text "list-notes" == "Couldn’t check where 1 title is available right now, so it’s left out."
