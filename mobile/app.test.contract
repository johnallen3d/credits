test "search starts empty"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  expect tree has "app"
  expect tree has "search"
  expect tree missing "recent"

test "start screen lists recently viewed titles"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"movie","id":603,"name":"The Matrix","year":"1999","image_url":null},{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  expect tree has "recent-movie-603"
  expect tree has "recent-person-6384"

test "the theme starts as Rosé Pine and survives a relaunch"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  expect state theme == "rose-pine"
  tap "theme"
  tap "theme-tokyo-night"
  expect state theme == "tokyo-night"
  reload
  expect state theme == "tokyo-night"

test "marking a movie a favorite shows the server's new marks"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/movie/603/favorite" with 200 {"marks":{"to_watch":true,"favorite":true,"watched":false}}
  expect tree has "mark-favorite"
  expect tree missing "favorite-badge"
  tap "mark-favorite"
  clock data
  expect tree has "favorite-badge"
  expect tree missing "mark-error"

test "a mark the server refuses says so"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false}}
  fail fetch "https://credits.jallen7usa.com/api/movie/603/watched"
  tap "mark-watched"
  clock data
  expect tree has "mark-error"
  expect refusal "marked"

test "marking a season watched unblurs and marks its episodes"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":false,"seasons":[],"episodes":[]}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1/watched" with 200 {"state":"read","show":false,"seasons":[1],"episodes":[]}
  expect text "season-state" == "Season not watched"
  expect text "mark-episode-1" == "Mark Watched"
  tap "mark-season"
  clock data
  expect text "season-state" == "Season watched"
  expect text "mark-episode-2" == "Watched"
  expect disabled "mark-episode-2"

test "marking one episode watched leaves the others"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":false,"seasons":[],"episodes":[]}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1/episode/1/watched" with 200 {"state":"read","show":false,"seasons":[],"episodes":[{"season":1,"number":1}]}
  tap "mark-episode-1"
  clock data
  expect text "mark-episode-1" == "Watched"
  expect text "mark-episode-2" == "Mark Watched"
  expect enabled "mark-episode-1"

test "a season watched with the whole show can't be unmarked here"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":true,"seasons":[],"episodes":[]}}
  expect text "season-state" == "Watched with the whole show"
  expect disabled "mark-season"
  expect text "mark-episode-1" == "Watched"

test "where to watch groups the offers and marks the user's services"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[{"kind":"stream","providers":[{"id":8,"name":"Netflix","logo_url":null,"mine":true},{"id":2528,"name":"YouTube TV","logo_url":null,"mine":false}]},{"kind":"rent","providers":[{"id":10,"name":"Amazon Video","logo_url":null,"mine":false}]},{"kind":"buy","providers":[{"id":10,"name":"Amazon Video","logo_url":null,"mine":false}]}],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
  clock data
  expect tree has "offers-stream"
  expect tree has "offers-rent"
  expect tree has "offers-buy"
  expect tree has "provider-8-mine"
  expect tree has "provider-2528"
  expect text "where-mine" == "On your services: Netflix"
  expect tree has "where-link"
  expect tree missing "where-stale"
  expect tree missing "services-not-chosen"

test "where to watch says when it couldn't be loaded rather than showing nothing"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"unavailable","link":null,"offers":[],"fetched_at":null,"my_services":"chosen"}}
  clock data
  expect tree has "where-unavailable"
  expect tree missing "where-none"
  expect tree missing "where-link"

test "where to watch says when nothing is offered, or the title is still in theaters"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
  clock data
  expect tree has "where-none"
  expect tree missing "where-unavailable"

test "a title in theaters with no offers says so"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":true,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
  clock data
  expect tree has "where-in-theaters"
  expect tree missing "where-none"

test "stale offers say when they were listed, and unreadable services say none are highlighted"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"stale","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[{"kind":"stream","providers":[{"id":8,"name":"Netflix","logo_url":null,"mine":false}]}],"fetched_at":"2026-11-02T10:00:00Z","my_services":"unreadable"}}
  clock data
  expect text "where-stale" == "Couldn’t refresh where to watch; showing what was listed on Nov 2, 2026."
  expect tree has "services-unreadable"
  expect tree missing "where-mine"

test "services not yet chosen ask to choose them"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[{"kind":"stream","providers":[{"id":8,"name":"Netflix","logo_url":null,"mine":false}]}],"fetched_at":"2026-11-02T10:00:00Z","my_services":"not_chosen"}}
  clock data
  expect tree has "services-not-chosen"
  expect tree missing "where-mine"

test "now playing lists movies with their dates and ratings, linking to their screens"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/now-playing?page=1" with 200 {"page":1,"total_pages":2,"titles":[{"id":603,"title":"The Matrix","release_date":"1999-03-31","poster_url":null,"rating":{"source":"imdb","score":8.7,"scale":10}},{"id":604,"title":"Unrated","release_date":null,"poster_url":null,"rating":null}]}
  answer fetch "https://credits.jallen7usa.com/api/now-playing?page=2" with 200 {"page":2,"total_pages":2,"titles":[{"id":605,"title":"The Matrix Revolutions","release_date":"2003-11-05","poster_url":null,"rating":null}]}
  tap "browse"
  tap "browse-now-playing"
  expect text "releases-title" == "Now Playing"
  expect tree has "release-603"
  expect tree has "release-604"
  expect tree missing "release-605"
  tap "more"
  expect tree has "release-605"
  expect tree missing "more"
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  tap "release-603"
  expect text "title" == "The Matrix"

test "coming soon says so when the server doesn't answer"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  fail fetch "https://credits.jallen7usa.com/api/coming-soon?page=1"
  tap "browse"
  tap "browse-coming-soon"
  expect text "releases-title" == "Coming Soon"
  expect tree missing "title-releases"

test "my services opens from the start screen's menu, grouped, with the chosen first"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":8,"name":"Netflix","logo_url":null}],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":true,"group":"mine"},{"id":337,"name":"Disney Plus","logo_url":null,"chosen":false,"group":"popular"},{"id":2,"name":"Apple TV Store","logo_url":null,"chosen":false,"group":"more"}],"state":"fresh","complete":true,"fetched_at":null}
  tap "browse"
  tap "open-services"
  clock settle
  clock data
  expect tree has "services-title"
  expect text "services-status" == "Your services: Netflix."
  expect tree has "service-8"
  expect tree has "service-337"
  expect tree has "service-2"
  expect tree missing "services-unavailable"

test "flipping a switch saves the choice and shows the new services"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"},{"id":337,"name":"Disney Plus","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  clock data
  expect text "services-status" == "No services chosen yet."
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":337,"name":"Disney Plus","logo_url":null}],"options":[{"id":337,"name":"Disney Plus","logo_url":null,"chosen":true,"group":"mine"},{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  type "service-337" "true"
  clock data
  expect text "services-status" == "Your services: Disney Plus."
  expect tree missing "services-error"

test "a save that fails says so"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  clock data
  fail fetch "https://credits.jallen7usa.com/api/services"
  type "service-8" "true"
  clock data
  expect tree has "services-error"
  expect text "services-status" == "No services chosen yet."

test "services that can't be loaded offer to try again"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  fail fetch "https://credits.jallen7usa.com/api/services"
  clock data
  expect tree has "services-retry"
  pass fetch "https://credits.jallen7usa.com/api/services"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[],"state":"fresh","complete":true,"fetched_at":null}
  tap "services-retry"
  clock data
  expect tree missing "services-retry"
  expect text "services-status" == "No services chosen yet."

test "without TMDB's list only the chosen services are listed, and it says why"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":8,"name":"Netflix","logo_url":null}],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":true,"group":"mine"}],"state":"unavailable","complete":false,"fetched_at":null}
  clock data
  expect tree has "services-unavailable"
  expect tree missing "services-partial"
  expect tree has "service-8"
test "a movie in theaters shows its release dates, rating and showtimes"
  at "/movie/7"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/7" with 200 {"kind":"movie","id":7,"title":"Opening Night","genres":[],"ratings":{"preferred":null},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false},"releases":{"region":"US","certification":"PG-13","dates":[{"kind":"theatrical","date":"2026-11-06","upcoming":false},{"kind":"digital","date":"2027-01-20","upcoming":true}]},"in_theaters":true,"showtimes_url":"https://www.fandango.com/search?q=Opening%20Night"}
  expect tree has "in-theaters"
  expect tree has "showtimes"
  expect tree has "release-theatrical"
  expect tree has "release-digital"
  expect tree has "certification"

test "a movie without dates or theaters shows none of them"
  at "/movie/8"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/8" with 200 {"kind":"movie","id":8,"title":"Old Film","genres":[],"ratings":{"preferred":null},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false},"releases":null,"in_theaters":false,"showtimes_url":null}
  expect tree has "title"
  expect tree missing "in-theaters"
  expect tree missing "showtimes"
  expect tree missing "title-releases"
