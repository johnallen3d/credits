use EmptyState from "exact:content"

// Credits spike: recently viewed, search, a title's detail and a season with spoiler guard, read
// straight from the credits JSON API (no data module, so no JavaScript engine).
// The web host reaches the API through tools/cors-proxy.ts; a phone would name the
// server itself.

// Two tabs, Home and Search, each its own stack. The menu's screens belong to Home;
// a title, person or photo is pushed onto whichever tab opened it.
routes nav
  tab home "/"
    services "/services"
    watchlist "/watchlist"
    favorites "/favorites"
    watched "/watched"
    releases "/releases/:list"
    playback "/playback"
    about "/about"
  tab search "/search"
  movie "/movie/:id"
    movieCredits "/movie/:id/credits"
  tv "/tv/:id"
    tvCredits "/tv/:id/credits"
    season "/tv/:id/season/:n"
      episode "/tv/:id/season/:n/episode/:e"
  person "/person/:id"
  photo "/photo/:url"

shape Hit
  kind: string
  id: number
  title: option<string>
  name: option<string>
  year: option<string>
  poster_url: option<string>
  profile_url: option<string>
  overview: option<string>
  known_for_department: option<string>
  known_for: option<HitKnownFor[]>
  in_theaters: option<bool>

// A title TMDB associates with a person in search.
shape HitKnownFor
  title: string
  year: option<string>

// A search hit or recently viewed page, as the search screen draws it.
shape Tile
  kind: string
  id: string
  label: string
  picture: string
  year: string

shape Recent
  kind: string
  id: number
  name: string
  year: option<string>
  image_url: option<string>

shape Score
  source: string
  score: number
  scale: number
  votes: option<number>

shape Ratings
  state: option<string>
  unavailable_reason: option<string>
  preferred: option<Score>
  others: option<Score[]>
  fetched_at: option<string>

// How current the TMDB data behind a page is: "stale" when it was served from
// cache because TMDB didn't answer. A response without it counts as fresh.
shape Metadata
  state: string
  fetched_at: string

shape CastMember
  person_id: number
  name: string
  role: option<string>
  episode_count: option<number>
  profile_url: option<string>

// Directors and writers (movies), creators and principal directors (TV).
shape KeyCrew
  role: string
  people: CastMember[]

// A title's whole cast and crew. The server leaves TV actors' episode counts
// out until the show is watched, as the web does.
shape Department
  name: string
  people: CastMember[]

shape Credits
  title: string
  year: option<string>
  cast: CastMember[]
  crew: Department[]

shape SeasonSummary
  number: number
  name: string
  year: option<string>
  episode_count: number

// Each is null when the server couldn't read it.
shape Marks
  to_watch: option<bool>
  favorite: option<bool>
  watched: option<bool>

// Where a title can be watched in the server's region, from the title API's
// where_to_watch. state is fresh, stale or unavailable; my_services is
// not_chosen, chosen or unreadable (whether mine could be set).
shape WatchProvider
  id: number
  name: string
  logo_url: option<string>
  mine: bool

shape OfferGroup
  kind: string
  providers: WatchProvider[]

shape WhereToWatch
  region: string
  state: string
  link: option<string>
  offers: OfferGroup[]
  fetched_at: option<string>
  my_services: string

// When a movie comes out in the server's region, and its age rating there.
shape ReleaseDate
  kind: string
  date: string
  upcoming: bool

shape TitleReleases
  region: string
  certification: option<string>
  dates: ReleaseDate[]

shape Title
  kind: string
  id: number
  title: string
  tagline: option<string>
  overview: option<string>
  year: option<string>
  genres: string[]
  runtime_minutes: option<number>
  poster_url: option<string>
  backdrop_url: option<string>
  ratings: Ratings
  key_crew: option<KeyCrew[]>
  cast: CastMember[]
  cast_total: option<number>
  crew_total: option<number>
  season_list: option<SeasonSummary[]>
  marks: Marks
  in_theaters: option<bool>
  where_to_watch: option<WhereToWatch>
  releases: option<TitleReleases>
  showtimes_url: option<string>
  metadata: option<Metadata>
  sources: option<string[]>

shape Episode
  number: number
  title: string
  air_date: option<string>
  overview: option<string>
  runtime_minutes: option<number>
  still_url: option<string>
  rating: option<Score>

shape EpisodeRef
  season: number
  number: number
  apple_tv: option<bool>

// state is "unreadable" when the marks couldn't be read; then nothing counts as
// watched and every episode stays blurred.
shape SeasonWatched
  state: option<string>
  show: bool
  seasons: number[]
  episodes: EpisodeRef[]

// A neighbouring season, for the season pager.
shape SeasonLink
  number: number
  name: string

shape Season
  show_title: string
  number: number
  name: string
  episodes: Episode[]
  previous: option<SeasonLink>
  next: option<SeasonLink>
  watched: SeasonWatched
  metadata: option<Metadata>

// The web's "My services" page: TMDB's streaming services for the region,
// grouped, with the ones chosen. Choosing one answers with the new page.
shape EpisodeRatings
  state: string
  unavailable_reason: option<string>

// An episode's own page. Its watched marks are the season's shape, so the same
// spoiler rules apply.
shape EpisodeDetail
  show_title: string
  season_number: number
  season_name: string
  number: number
  title: string
  air_date: option<string>
  overview: option<string>
  runtime_minutes: option<number>
  still_url: option<string>
  rating: option<Score>
  episode_ratings: EpisodeRatings
  key_crew: KeyCrew[]
  cast: CastMember[]
  guest_stars: CastMember[]
  previous: option<number>
  next: option<number>
  watched: SeasonWatched
  metadata: option<Metadata>

shape ServiceOption
  id: number
  name: string
  logo_url: option<string>
  chosen: bool
  group: string

shape ServicesChosen
  name: string

shape Services
  region: string
  chosen: ServicesChosen[]
  options: ServiceOption[]
  state: string
  complete: bool
  fetched_at: option<string>

// A person page. `sort` is the web's: "date" (newest first) or "rating".
shape FilmCredit
  kind: string
  id: number
  title: string
  year: option<string>
  role: option<string>
  episode_count: option<number>
  poster_url: option<string>
  rating: option<Score>

shape CreditGroup
  department: string
  entries: FilmCredit[]

shape SortRatings
  unrated: number
  unavailable_reason: option<string>

shape Person
  id: number
  name: string
  known_for: option<string>
  biography: option<string>
  birthday: option<string>
  deathday: option<string>
  place_of_birth: option<string>
  profile_url: option<string>
  known_for_titles: FilmCredit[]
  filmography: CreditGroup[]
  sort: string
  sort_ratings: option<SortRatings>

// The To Watch, Favorites and Watched lists, as the web's /watchlist, /favorites
// and /watched show them: the server orders and answers each list; the screen
// filters it and counts each choice.
shape ListEntry
  kind: string
  id: number
  title: string
  year: option<string>
  poster_url: option<string>
  rating: option<Score>
  in_theaters: option<bool>
  next_release: option<ReleaseDate>
  release_status: option<string>
  sources: option<string[]>
  availability: option<ListAvailability>

// To Watch only, once services are chosen: which of them include a title.
shape ListAvailability
  state: string
  services: ListService[]

shape ListService
  name: string

// To Watch only: whether the user's services are chosen, and how many titles'
// offers couldn't be loaded or were served stale.
shape ListServices
  state: string
  unknown: number
  stale_since: option<string>

shape ListSortRatings
  unrated: number
  stale_since: option<string>
  unavailable_reason: option<string>

shape SavedList
  titles: ListEntry[]
  sort_ratings: option<ListSortRatings>
  release_unknown: option<number>
  services: option<ListServices>

// A To Watch title's tags naming who or what recommended it, and the tags used
// on To Watch so far (most recent first), offered when tagging.
shape SourceTags
  sources: string[]

shape ShowProgress
  show: bool
  seasons: number[]
  episodes: number

shape WatchedTitle
  kind: string
  id: number
  title: option<string>
  year: option<string>
  poster_url: option<string>
  last_watched_at: string
  progress: option<ShowProgress>
  sources: string[]

shape WatchedList
  titles: WatchedTitle[]
  stale_since: option<string>

// Seen on Apple TV: what Home Assistant reports playing, and shows waiting on
// a choice of TMDB show or movie.
shape LiveStatus
  state: string
  since: option<string>
  error: option<string>

shape SyncStatus
  state: string
  at: option<string>
  error: option<string>
  last_ok: option<string>

shape Candidate
  id: number
  name: string
  year: option<string>
  overview: option<string>

shape PendingShow
  app: string
  kind: string
  show_key: string
  show_title: string
  note: option<string>
  episodes: string[]
  candidates: option<Candidate[]>

shape Detection
  app: string
  item_key: string
  kind: string
  show_title: string
  title: string
  season: number
  episode: number
  duration: option<number>
  playing_seconds: number
  max_position: option<number>
  last_seen: string
  status: string
  tmdb_id: option<number>
  note: option<string>

shape Playback
  live: LiveStatus
  status: SyncStatus
  players: string[]
  pending: PendingShow[]
  recent: Detection[]
  unreadable: bool

source search(q: string) as shape Hit[]
  url "https://credits.jallen7usa.com/api/search?q={q}"
  pointer "/results"

// The home page's recently viewed list. Reading a title through the API doesn't
// count as a view, so opening one posts it, as the web page's load does.
source recent() as shape Recent[]
  url "https://credits.jallen7usa.com/api/recent"
  pointer "/recent"

source recordView(kind: string, id: number) as shape Recent[]
  url "https://credits.jallen7usa.com/api/recent"
  method "POST"
  body json
  pointer "/recent"

// The web's Now Playing and Coming Soon pages: movies in the region's theaters,
// twenty a page.
shape Release
  id: number
  title: string
  release_date: option<string>
  poster_url: option<string>
  rating: option<Score>

shape Releases
  page: number
  total_pages: number
  titles: Release[]

source releases(list: string, page: number) as shape Releases
  url "https://credits.jallen7usa.com/api/{list}?page={page}"

source services() as shape Services
  url "https://credits.jallen7usa.com/api/services"

source chooseService(id: number, chosen: bool) as shape Services
  url "https://credits.jallen7usa.com/api/services"
  method "POST"
  body json

source title(kind: string, id: string) as shape Title
  url "https://credits.jallen7usa.com/api/{kind}/{id}"

// Marks: each PUT answers with the marks after the change. The body carries every
// parameter; the server reads only `listed` or `watched`.
source setToWatch(kind: string, id: string, listed: bool) as shape Marks
  url "https://credits.jallen7usa.com/api/{kind}/{id}/watchlist"
  method "PUT"
  body json
  pointer "/marks"

source setFavorite(kind: string, id: string, listed: bool) as shape Marks
  url "https://credits.jallen7usa.com/api/{kind}/{id}/favorite"
  method "PUT"
  body json
  pointer "/marks"

source setWatched(kind: string, id: string, watched: bool) as shape Marks
  url "https://credits.jallen7usa.com/api/{kind}/{id}/watched"
  method "PUT"
  body json
  pointer "/marks"

source setSeasonWatched(id: string, n: string, watched: bool) as shape SeasonWatched
  url "https://credits.jallen7usa.com/api/tv/{id}/season/{n}/watched"
  method "PUT"
  body json

source setEpisodeWatched(id: string, n: string, episode: number, watched: bool) as shape SeasonWatched
  url "https://credits.jallen7usa.com/api/tv/{id}/season/{n}/episode/{episode}/watched"
  method "PUT"
  body json

source credits(kind: string, id: string) as shape Credits
  url "https://credits.jallen7usa.com/api/{kind}/{id}/credits"

source season(id: string, n: string) as shape Season
  url "https://credits.jallen7usa.com/api/tv/{id}/season/{n}"

source episode(id: string, n: string, e: string) as shape EpisodeDetail
  url "https://credits.jallen7usa.com/api/tv/{id}/season/{n}/episode/{e}"

source person(id: string, sort: string) as shape Person
  url "https://credits.jallen7usa.com/api/person/{id}?sort={sort}"

// The To Watch and Favorites lists (`list` is the API's name for each), sorted by the server.
source savedList(list: string, sort: string) as shape SavedList
  url "https://credits.jallen7usa.com/api/{list}?sort={sort}"

// Replaces a To Watch title's tags; the server tidies each (no `#`, words
// hyphenated) and answers with the tags as saved.
source setSources(kind: string, id: string, sources: string[]) as shape SourceTags
  url "https://credits.jallen7usa.com/api/{kind}/{id}/watchlist/sources"
  method "PUT"
  body json

source watchlistSources() as shape SourceTags
  url "https://credits.jallen7usa.com/api/watchlist/sources"

source watchedList(sort: string) as shape WatchedList
  url "https://credits.jallen7usa.com/api/watched?sort={sort}"
source playback() as shape Playback
  url "https://credits.jallen7usa.com/api/playback"

source decidePlayback(app: string, kind: string, show_key: string, tmdb_id: number) as shape Playback
  url "https://credits.jallen7usa.com/api/playback/decide"
  method "POST"
  body json

source ignorePlayback(app: string, kind: string, show_key: string) as shape Playback
  url "https://credits.jallen7usa.com/api/playback/decide"
  method "POST"
  body json

fn text(o: option<string>): string = match o { case some(s) => s, case none => "" }
// Source tags as "#one #two"; "" when there are none.
fn hashtags(o: option<string[]>): string = match o { case some(xs) => xs.map(s => `#${s}`).join(" "), case none => "" }
fn sourceList(o: option<string[]>): string[] = match o { case some(xs) => xs, case none => [] }
// Tags typed in one field, split at spaces; the server drops a leading `#`.
fn typedTags(draft: string): string[] = draft.split(" ").filter(x => x.trim() != "" and x.trim() != "#")
// Tags used before that the title doesn't have yet, most recent first.
fn tagSuggestions(known: string[], has: string[]): string[] = known.filter(k => not has.map(h => h.toLowerCase()).includes(k.toLowerCase())).slice(0, 8)
fn label(h: Hit): string = match h.title { case some(t) => t, case none => text(h.name) }
fn picture(h: Hit): string = match h.poster_url { case some(u) => u, case none => text(h.profile_url) }
fn numberOf(s: string): number = match parseNumber(s) { case some(n) => n, case none => 0 }
fn fromHit(h: Hit): Tile = Tile(kind=h.kind, id=`${h.id}`, label=label(h), picture=picture(h), year=text(h.year))
// A title's overview, or a person's department and best-known titles, as on the web.
fn knownForList(h: Hit): string = match h.known_for { case some(ks) => ks.map(k => match k.year { case some(y) => `${k.title} (${y})`, case none => k.title }).join(", "), case none => "" }
fn personLine(dept: string, titles: string): string = dept != "" and titles != "" ? `${dept} · known for ${titles}` : dept != "" ? dept : titles != "" ? `Known for ${titles}` : ""
fn hitSummary(h: Hit): string = h.kind == "person" ? personLine(text(h.known_for_department), knownForList(h)) : text(h.overview)
// A list's titles as `kind-id`, to mark search results already on it.
fn entryKeys(l: SavedList): string[] = l.titles.map(e => `${e.kind}-${e.id}`)
fn fromRecent(r: Recent): Tile = Tile(kind=r.kind, id=`${r.id}`, label=r.name, picture=text(r.image_url), year=text(r.year))
fn kindName(k: string): string = k == "movie" ? "Movie" : k == "tv" ? "TV" : "Person"
fn scoreOf(o: option<Score>): string = match o {
  case some(s) => s.scale == 100 ? `RT ${round(s.score)}%` : `IMDb ${s.score}`,
  case none => "" }
fn releaseList(l: string): string = l == "coming-soon" ? "Coming Soon" : "Now Playing"
fn releasesListOf(es: Entry[]): string = match es.filter(e => e.name == "releases").at(-1) { case some(e) => e.params.list, case none => "" }
fn releasesPageNumbers(es: Entry[], pages: number): number[] = releasesListOf(es) == "" ? [] : range(pages).map(i => i + 1)
fn releaseLine(r: Release): string = match r.release_date {
  case some(d) => scoreOf(r.rating) == "" ? formatDate(d, 0, "medium") : `${formatDate(d, 0, "medium")} · ${scoreOf(r.rating)}`,
  case none => scoreOf(r.rating) }
// A score as the web's rings show it: its share of the scale, the source's
// colour (Rotten Tomatoes by its Fresh or Rotten verdict), and its own form.
fn isTomatometer(s: Score): bool = s.source == "rotten_tomatoes"
fn fresh(s: Score): bool = s.score >= 60
fn ringPercent(s: Score): number = min(100, max(0, round(s.score / max(1, s.scale) * 100)))
fn tone(s: Score): string = isTomatometer(s) ? (fresh(s) ? "score.fresh" : "score.rotten") : "score.imdb"
fn sourceName(s: Score): string = isTomatometer(s) ? "Rotten Tomatoes" : "IMDb"
fn scoreShown(s: Score): string = isTomatometer(s) ? `${round(s.score)}%` : `${s.score.toFixed(1)}/${s.scale}`
fn verdict(s: Score): string = fresh(s) ? "Fresh" : "Rotten"
fn ringLabel(s: Score): string = isTomatometer(s) ? `Rotten Tomatoes: ${verdict(s)}, ${scoreShown(s)}` : `IMDb, ${scoreShown(s)}`
fn scoreNote(s: Score): string = isTomatometer(s) ? verdict(s) : match s.votes {
  case some(v) => `${scoreShown(s)} · ${formatNumber(v, "decimal", 0)} votes`,
  case none => scoreShown(s) }
fn othersOf(r: Ratings): Score[] = match r.others { case some(xs) => xs, case none => [] }
fn hasScores(r: Ratings): bool = othersOf(r).length > 0 or (match r.preferred { case some(p) => true, case none => false })
fn seasonsOf(t: Title): SeasonSummary[] = match t.season_list { case some(xs) => xs.filter(x => x.episode_count > 0), case none => [] }
fn keyRole(r: string): string = r == "creator" ? "Created by" : r == "director" ? "Directed by" : "Written by"
fn episodes(o: option<number>): string = match o { case some(n) => n == 1 ? "1 episode" : `${n} episodes`, case none => "" }
fn creditLine(prefix: string, c: CastMember): string = [match c.role { case some(r) => `${prefix}${r}`, case none => "" }, episodes(c.episode_count)].filter(x => x != "").join(" · ")
fn countOf(o: option<number>): number = match o { case some(n) => n, case none => 0 }
fn keyCrewOf(t: Title): KeyCrew[] = match t.key_crew { case some(xs) => xs, case none => [] }
fn moreCredits(t: Title): bool = countOf(t.cast_total) > t.cast.slice(0, 10).length or countOf(t.crew_total) > 0
fn themeName(t: string): string = t == "tokyo-night" ? "Tokyo Night" : t == "catppuccin" ? "Catppuccin" : t == "classic" ? "Classic" : "Rosé Pine"
fn seasonSeen(w: SeasonWatched, season: number): bool = w.show or w.seasons.filter(n => n == season).length > 0
fn theatersOf(t: Title): bool = match t.in_theaters { case some(b) => b, case none => false }
fn creditScore(o: option<Score>): string = match o {
  case some(s) => s.scale == 100 ? `${round(s.score)}%` : `${s.score}`,
  case none => "" }
fn creditPath(c: FilmCredit): string = c.kind == "movie" ? path("movie", `${c.id}`) : path("tv", `${c.id}`)
fn filmLine(c: FilmCredit, acting: bool): string = [
  c.year == none ? "TBA" : text(c.year), kindName(c.kind),
  text(c.role) == "" ? "" : acting ? `as ${text(c.role)}` : text(c.role),
  match c.episode_count { case some(n) => `${n} ${n == 1 ? "episode" : "episodes"}`, case none => "" }
  ].filter(x => x != "").join(" · ")
// A person's credits of one kind ("all", "movie" or "tv"), as the web's Show filter keeps them.
fn creditKept(c: FilmCredit, kind: string): bool = kind == "all" or c.kind == kind
fn creditCount(p: Person, kind: string): number = p.filmography.map(g => g.entries.filter(c => creditKept(c, kind))).flat().length
fn keptGroups(p: Person, kind: string): CreditGroup[] = p.filmography.map(g => CreditGroup(department=g.department, entries=g.entries.filter(c => creditKept(c, kind)))).filter(g => g.entries.length > 0)
fn paragraphs(o: option<string>): string[] = text(o).split("\n").map(l => l.trim()).filter(l => l != "")
fn bornText(p: Person): string = match p.birthday {
  case some(d) => p.place_of_birth == none ? formatDate(d, 0, "medium") : `${formatDate(d, 0, "medium")} in ${text(p.place_of_birth)}`,
  case none => text(p.place_of_birth) }
fn ratingNote(p: Person): string = match p.sort_ratings {
  case some(r) => match r.unavailable_reason {
    case some(why) => why == "not_configured" ? "Ratings aren’t configured on this server, so credits stay in date order." : "Some ratings couldn’t be loaded right now.",
    case none => p.sort == "rating" and r.unrated > 0 ? "Credits without a Rotten Tomatoes or IMDb score are listed last, newest first." : "" },
  case none => "" }
fn seen(w: SeasonWatched, season: number, ep: number): bool =
  seasonSeen(w, season) or w.episodes.filter(e => e.season == season and e.number == ep).length > 0
// Whether the episode's own mark came from what played on the Apple TV.
fn fromAppleTv(w: SeasonWatched, season: number, ep: number): bool =
  w.episodes.filter(e => e.season == season and e.number == ep and yes(e.apple_tv)).length > 0
fn episodeScore(e: EpisodeDetail): string = scoreOf(e.rating) != "" ? scoreOf(e.rating) : e.episode_ratings.state == "unavailable" ? "Ratings unavailable" : "No IMDb score"
fn episodeFacts(e: EpisodeDetail): string = [match e.air_date { case some(d) => formatDate(d, 0, "medium"), case none => "Not announced" }, match e.runtime_minutes { case some(m) => `${m} min`, case none => "" }].filter(x => x != "").join(" · ")
fn listedEpisodeFacts(e: Episode, appleTv: bool): string = [match e.air_date { case some(d) => formatDate(d, 0, "medium"), case none => "Air date not announced" }, match e.runtime_minutes { case some(m) => `${m} min`, case none => "" }, appleTv ? "Watched on Apple TV" : ""].filter(x => x != "").join(" · ")
fn titleFacts(t: Title): string = [text(t.year), match t.runtime_minutes { case some(m) => `${m} min`, case none => "" }, t.genres.join(", ")].filter(x => x != "").join(" · ")
fn offerLabel(k: string): string = k == "stream" ? "Stream" : k == "free" ? "Free" : k == "ads" ? "Free with ads" : k == "rent" ? "Rent" : "Buy"
fn uniq(xs: string[]): string[] = range(xs.length).filter(i => xs.indexOf(text(xs.at(i))) == i).map(i => text(xs.at(i)))
fn myServices(w: WhereToWatch): string[] = uniq(w.offers.map(g => g.providers.filter(p => p.mine).map(p => p.name)).flat())
fn listedOn(w: WhereToWatch): string = match w.fetched_at { case some(t) => formatDate(t.slice(0, 10), 0, "medium"), case none => "" }
fn releaseLabel(d: ReleaseDate): string = d.kind == "theatrical" ? "In theaters" : d.kind == "digital" ? "Digital" : d.kind == "physical" ? "Physical" : d.upcoming ? "Release" : "Released"
fn releaseDay(d: ReleaseDate): string = d.upcoming ? `Coming ${formatDate(d.date, 0, "medium")}` : formatDate(d.date, 0, "medium")
fn yes(o: option<bool>): bool = match o { case some(b) => b, case none => false }
fn unknown(o: option<bool>): bool = match o { case some(b) => false, case none => true }
fn day(iso: string): string = formatDate(iso.slice(0, 10), 0, "medium")
// The web's notices, word for word, for data served stale or not loaded.
fn stateOf(o: option<string>): string = match o { case some(s) => s, case none => "fresh" }
fn staleNote(m: option<Metadata>): string = match m {
  case some(x) => x.state == "stale" ? `TMDB isn’t responding, so this page shows details saved on ${day(x.fetched_at)}. They may be out of date.` : "",
  case none => "" }
fn ratingsNote(r: Ratings): string = (stateOf(r.state) == "unavailable"
  ? (match r.unavailable_reason {
      case some(why) => why == "not_configured" ? "Ratings aren’t configured on this server." : why == "no_imdb_id" ? "No IMDb entry is linked to this title." : "Ratings couldn’t be loaded right now.",
      case none => "Ratings couldn’t be loaded right now." })
  : stateOf(r.state) == "stale"
    ? (match r.fetched_at { case some(at) => `Couldn’t refresh ratings; showing scores from ${day(at)}.`, case none => "Couldn’t refresh ratings." })
    : "")
// The original upload behind a sized TMDB image URL (…/t/p/w342/x.jpg to
// …/t/p/original/x.jpg), as the web's lightbox opens.
fn fullSize(url: string): string = (url.includes("/t/p/")
  ? `${url.split("/t/p/").slice(0, 1).join("")}/t/p/original/${url.split("/").slice(-1).join("")}`
  : url)
// Where a tap on a poster, backdrop, photo or still goes: the image full screen.
fn photoPath(url: string): string = path("photo", url)
fn listName(l: string): string = l == "watchlist" ? "To Watch" : l == "favorites" ? "Favorites" : "Watched"
fn listKindLabel(k: string): string = k == "movie" ? "Movies" : k == "tv" ? "TV" : "All"
fn listKindWord(k: string): string = k == "movie" ? "movies" : k == "tv" ? "TV shows" : "titles"
fn kindMatches(k: string, filter: string): bool = filter == "all" or k == filter
fn releaseFilterLabel(r: string): string = r == "out_now" ? "Out now" : r == "coming_soon" ? "Coming soon" : "All"
fn releaseMatches(e: ListEntry, filter: string): bool = filter == "all" or text(e.release_status) == filter
// The user's services that include a title; none when its offers couldn't be loaded.
fn servicesOf(e: ListEntry): string[] = match e.availability { case some(a) => a.services.map(x => x.name), case none => [] }
fn servicesMatch(e: ListEntry, filter: string): bool = filter != "mine" or servicesOf(e).length > 0
fn tagsOf(e: ListEntry): string[] = match e.sources { case some(xs) => xs, case none => [] }
// A tag filter ignores case, as the server's does; "" is every title.
fn tagMatches(e: ListEntry, tag: string): bool = tag == "" or tagsOf(e).map(x => x.toLowerCase()).includes(tag.toLowerCase())
fn listTags(xs: ListEntry[]): string[] = uniq(xs.map(e => tagsOf(e)).flat())
fn shownEntries(xs: ListEntry[], kind: string, release: string, services: string, tag: string): ListEntry[] = xs.filter(e => kindMatches(e.kind, kind) and releaseMatches(e, release) and servicesMatch(e, services) and tagMatches(e, tag))
fn servicesState(l: SavedList): string = match l.services { case some(s) => s.state, case none => "" }
fn servicesFilterLabel(f: string): string = f == "mine" ? "On my services" : "Anywhere"
// What stood behind the services filter, as the web's To watch says it.
fn servicesNote(o: option<ListServices>, filter: string): string = match o {
  case some(s) => s.state == "unreadable" ? "Your services couldn’t be read, so titles can’t be filtered by them."
    : s.state == "not_chosen" ? "Choose your streaming services in My Services to see which titles you can watch on them."
    : [s.unknown > 0 ? `Couldn’t check where ${plural(s.unknown, "title is", "titles are")} available right now${filter == "mine" ? s.unknown == 1 ? ", so it’s left out" : ", so they’re left out" : ""}.` : "",
       text(s.stale_since) == "" ? "" : `Couldn’t refresh where some titles are available; using listings from as early as ${day(text(s.stale_since))}.`].filter(x => x != "").join(" "),
  case none => "" }
fn emptyListMessage(kind: string, release: string, services: string, tag: string): string = (services == "all" and tag == ""
  ? (release == "all" ? `No ${listKindWord(kind)} on your list.` : `None of the ${listKindWord(kind)} on your list are ${release == "out_now" ? "out now" : "coming soon"}.`)
  : `None of the ${listKindWord(kind)} on your list match these filters.`)
fn sourceLabel(s: string): string = s == "manual" ? "By hand" : s == "apple_tv" ? "Apple TV" : "Any way"
fn sourceMatches(t: WatchedTitle, filter: string): bool = filter == "any" or t.sources.includes(filter)
fn shownWatched(xs: WatchedTitle[], kind: string, source: string): WatchedTitle[] = xs.filter(t => kindMatches(t.kind, kind) and sourceMatches(t, source))
fn titlePath(kind: string, id: number): string = kind == "movie" ? path("movie", `${id}`) : path("tv", `${id}`)
fn plural(n: number, one: string, many: string): string = n == 1 ? `${n} ${one}` : `${n} ${many}`
fn nth(xs: number[], i: number): number = match xs.at(i) { case some(x) => x, case none => 0 }
// "2", "1, 2", "1–3", "1, 3–4": a run of three or more collapses, as the web's does.
fn seasonRun(ns: number[]): string = ns.length == 1 ? `${nth(ns, 0)}` : nth(ns, -1) - nth(ns, 0) != ns.length - 1 ? ns.join(", ") : ns.length == 2 ? `${nth(ns, 0)}, ${nth(ns, 1)}` : `${nth(ns, 0)}–${nth(ns, -1)}`
fn seasonsOfNumbers(ns: number[], specials: bool): string = ns.length == 0 ? (specials ? "Specials" : "") : `${ns.length == 1 ? "Season" : "Seasons"} ${seasonRun(ns)}${specials ? ", specials" : ""}`
fn progressText(o: option<ShowProgress>): string = match o {
  case some(p) => p.show ? "Whole show" : [seasonsOfNumbers(p.seasons.filter(x => x > 0), p.seasons.includes(0)), p.episodes > 0 ? episodes(some(p.episodes)) : ""].filter(x => x != "").join(" · "),
  case none => "" }
fn sortStale(o: option<ListSortRatings>): string = match o { case some(r) => text(r.stale_since), case none => "" }
fn releaseNote(o: option<number>, release: string): string = match o {
  case some(n) => n > 0 ? `Couldn’t check the release dates of ${plural(n, "title", "titles")} right now${release == "all" ? "" : n == 1 ? ", so it’s left out" : ", so they’re left out"}.` : "",
  case none => "" }
fn listRatingsNote(o: option<ListSortRatings>): string = match o {
  case some(r) => text(r.unavailable_reason) == "not_configured" ? "Ratings aren’t configured on this server, so titles stay in the order they were added."
    : text(r.unavailable_reason) != "" ? "Some ratings couldn’t be loaded right now."
    : r.unrated > 0 ? "Titles without a Rotten Tomatoes or IMDb score are listed last, most recently added first." : "",
  case none => "" }
// The notes under a list: what couldn't be checked, what stood behind a by-rating
// order, and when stale scores were saved.
fn savedNotes(l: SavedList, release: string, services: string): string = [releaseNote(l.release_unknown, release), servicesNote(l.services, services), listRatingsNote(l.sort_ratings),
  sortStale(l.sort_ratings) == "" ? "" : `Couldn’t refresh some ratings; using scores from as early as ${day(sortStale(l.sort_ratings))}.`].filter(x => x != "").join(" ")
fn watchedNotesAbout(shown: WatchedTitle[], sort: string, stale: string): string = [
  shown.filter(t => t.title == none).length == 0 ? "" : `Couldn’t load the details of ${plural(shown.filter(t => t.title == none).length, "title", "titles")} from TMDB right now${sort == "title" ? ", so they’re listed last" : ""}.`,
  stale == "" ? "" : `Couldn’t refresh some titles; using details from as early as ${day(stale)}.`].filter(x => x != "").join(" ")
fn entryNotes(e: ListEntry): string = [hashtags(e.sources), servicesOf(e).length > 0 ? `On ${servicesOf(e).join(", ")}` : "", yes(e.in_theaters) ? "In theaters" : "", match e.next_release { case some(r) => `${releaseLabel(r)} ${releaseDay(r)}`, case none => "" }, scoreOf(e.rating)].filter(x => x != "").join(" · ")
fn watchedNotes(t: WatchedTitle): string = [progressText(t.progress), `Watched ${day(t.last_watched_at)}`, t.sources.includes("apple_tv") ? "Apple TV" : ""].filter(x => x != "").join(" · ")
fn watchedTitle(t: WatchedTitle): string = match t.title { case some(s) => s, case none => `${kindName(t.kind)} #${t.id}` }

keyframes drawer-in
  from translate="-100% 0px"

component App
  // The web's theme picker, remembered on the phone. The dark themes keep the
  // system chrome dark; Classic follows the phone's light or dark.
  state theme = "rose-pine" persist
  state query = ""
  state asked = ""
  resource hits = search(asked) when asked != "" as shape Hit[] else empty()
  // To Watch and Favorites, read while searching or on a person's page to mark each
  // title result or credit, as the web's are. Each is asked again whenever the search
  // screen or a person's page comes back.
  derive marksWanted = asked != "" or stack(nav).filter(e => e.name == "person").length > 0
  resource toWatchList = savedList("watchlist", "added") when marksWanted as shape SavedList
  resource favoritesList = savedList("favorites", "added") when marksWanted as shape SavedList
  mutation hitMarked as shape Marks queue refreshes toWatchList, favoritesList
  mutation creditMarked as shape Marks queue refreshes toWatchList, favoritesList
  derive toWatchKnown = current(toWatchList) and not failed(toWatchList)
  derive favoritesKnown = current(favoritesList) and not failed(favoritesList)
  derive toWatchKeys = toWatchKnown ? entryKeys(toWatchList) : []
  derive favoriteKeys = favoritesKnown ? entryKeys(favoritesList) : []
  resource recents = recent() as shape Recent[] else empty()
  mutation viewed as shape Recent[] refreshes recents
  // The releases screen's pages, one request each: More asks for the next.
  state releasesPages = 1
  state edgePull = 0
  resource releasesLoaded = releases(releasesListOf(stack(nav)), n) for n in releasesPageNumbers(stack(nav), releasesPages) key=`${n}` as shape Releases

  task scheme when theme != "" key=theme
    change(applyScheme)
  task searchShown when top(nav).name == "search" key="search"
    change(refreshMarks)
  task personShown when top(nav).name == "person" key=top(nav).id
    change(refreshMarks)
  task opened when top(nav).name == "movie" or top(nav).name == "tv" or top(nav).name == "person" key=top(nav).id
    change(record)

  action edit(v: string)
    query = v
    asked = v.trim()
  action retry
    refresh hits
  action reloadRecents
    refresh recents
  action refreshMarks
    refresh toWatchList
    refresh favoritesList
  action markToWatch(kind: string, id: string, listed: bool)
    send hitMarked = setToWatch(kind, id, listed)
  action markFavorite(kind: string, id: string, listed: bool)
    send hitMarked = setFavorite(kind, id, listed)
  action markCreditToWatch(kind: string, id: string, listed: bool)
    send creditMarked = setToWatch(kind, id, listed)
  action markCreditFavorite(kind: string, id: string, listed: bool)
    send creditMarked = setFavorite(kind, id, listed)
  action back
    nav = back(nav)
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action closeMenu
    close("drawer")
  // A drag in from Home's left edge pulls the menu out: far enough or fast enough.
  action edgePan(dx: number, dy: number)
    edgePull = edgePull + dx
  action edgeReleased(vx: number, vy: number)
    if edgePull > 40 or vx > 300
      showModal("drawer")
    edgePull = 0
  action open(url: string)
    close("drawer")
    nav = go(nav, url)
  action browse(l: string)
    close("drawer")
    releasesPages = 1
    nav = go(nav, path("releases", l))
  action releasesMore
    releasesPages = releasesPages + 1
  action releasesRetry
    refresh releasesLoaded
  action pickTheme(t: string)
    theme = t
  action applyScheme
    setScheme(theme == "classic" ? "system" : "dark")
  action record
    send viewed = recordView(top(nav).name, numberOf(top(nav).params.id))

  view
    main navigationKey=`${top(nav).id}` navigate=follow testId="app" width="100%" height="100%"
      -exact-mode=`palette=${theme}` display="flex" flex-direction="column"
      background-color="surface.page" color="text.primary"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              // Home: the menu and what was viewed lately; pull down to reload it.
              if e.name == "home"
                column navigationKey=`${e.id}` navigationScroll="recent" position="absolute" inset=0
                  display="flex" flex-direction="column"
                  header display="flex" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
                    button command="show-modal" commandfor="drawer" aria-label="Menu" testId="menu"
                      image "symbol:menu" color="accent"
                    text "Credits" role="heading" aria-level=1 flex=1
                  if recents.length > 0
                    scroll id="recent" testId="recent" refresh=reloadRecents refreshing=pending(recents) flex=1 min-height=0 background-color="surface.page"
                      Shelves(prefix="recent", people=recents.filter(r => r.kind == "person").map(r => fromRecent(r)),
                        titles=recents.filter(r => r.kind != "person").map(r => fromRecent(r)), peopleHeading="Recent People", titlesHeading="Recently Viewed")
                  else
                    EmptyState(symbol="symbol:play", title="Nothing Viewed Yet", message="Titles and people you open show up here.")
                      button press=pick("search") testId="home-search"
                        text "Search"
                  // The left edge's strip, over the page: a drag in from it opens the menu.
                  column position="absolute" top=0 bottom=0 left=0 width=20 touch-action="pan-y"
                    pan=edgePan panrelease=edgeReleased aria-hidden=true testId="menu-edge"
              // Search: the field in the bar, and its results.
              if e.name == "search"
                column navigationKey=`${e.id}` navigationScroll="hits" position="absolute" inset=0
                  display="flex" flex-direction="column"
                  header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
                    text "Search" role="heading" aria-level=1 flex=1
                    input type="search" value=query input=edit placeholder="Movies, shows, people" autofocus=true
                      aria-label="Search" testId="search" width="100%"
                  if asked == ""
                    EmptyState(symbol="symbol:search", title="Find Anything", message="Search for a movie, show or person.")
                  else if failed(hits)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach Credits", message="The server didn’t answer.")
                      button press=retry testId="retry"
                        text "Try Again"
                  else if hits.length == 0 and not pending(hits)
                    EmptyState(symbol="symbol:search", title=`No Results for “${asked}”`, message="Check the spelling or try a new search.")
                  else
                    scroll id="hits" flex=1 min-height=0 background-color="surface.page"
                      column gap=24 padding="8px 0 32px"
                        if failed(hitMarked) and not pending(hitMarked)
                          text "Couldn’t save the mark. Try again." font="-exact-footnote" color="mark.favorite"
                            padding="0 16px" role="status" testId="hit-mark-error"
                        if hits.filter(h => h.kind == "person").length > 0
                          HitList(heading="People", hits=hits.filter(h => h.kind == "person"), toWatchKeys=[], favoriteKeys=[],
                            toWatchKnown=false, favoritesKnown=false, busy=false, toWatch=markToWatch, favorite=markFavorite)
                        if hits.filter(h => h.kind != "person").length > 0
                          HitList(heading="Movies & TV", hits=hits.filter(h => h.kind != "person"), toWatchKeys=toWatchKeys,
                            favoriteKeys=favoriteKeys, toWatchKnown=toWatchKnown, favoritesKnown=favoritesKnown,
                            busy=pending(hitMarked), toWatch=markToWatch, favorite=markFavorite)
              if e.name == "services"
                ServicesScreen(navKey=`${e.id}`)
              if e.name == "movie"
                TitleScreen(navKey=`${e.id}`, kind="movie", id=e.params.id)
              if e.name == "tv"
                TitleScreen(navKey=`${e.id}`, kind="tv", id=e.params.id)
              if e.name == "movieCredits"
                CreditsScreen(navKey=`${e.id}`, kind="movie", id=e.params.id)
              if e.name == "tvCredits"
                CreditsScreen(navKey=`${e.id}`, kind="tv", id=e.params.id)
              if e.name == "season"
                SeasonScreen(navKey=`${e.id}`, id=e.params.id, n=e.params.n)
              if e.name == "episode"
                EpisodeScreen(navKey=`${e.id}`, id=e.params.id, n=e.params.n, e=e.params.e)
              if e.name == "person"
                PersonScreen(navKey=`${e.id}`, id=e.params.id, toWatchKeys=toWatchKeys, favoriteKeys=favoriteKeys,
                  toWatchKnown=toWatchKnown, favoritesKnown=favoritesKnown, busy=pending(creditMarked),
                  markFailed=(failed(creditMarked) and not pending(creditMarked)), toWatch=markCreditToWatch, favorite=markCreditFavorite)
              if e.name == "watchlist" or e.name == "favorites"
                SavedListScreen(navKey=`${e.id}`, list=e.name)
              if e.name == "watched"
                WatchedScreen(navKey=`${e.id}`)
              if e.name == "releases"
                ReleasesScreen(navKey=`${e.id}`, list=e.params.list, loaded=releasesLoaded, pages=releasesPages,
                  pending=pending(releasesLoaded), failed=failed(releasesLoaded), more=releasesMore, retry=releasesRetry)
              if e.name == "photo"
                PhotoScreen(navKey=`${e.id}`, url=e.params.url, close=back)
              if e.name == "playback"
                PlaybackScreen(navKey=`${e.id}`)
              if e.name == "about"
                AboutScreen(navKey=`${e.id}`)
      // The tab bar; tapping the tab already shown returns to its start. iOS 26 sets
      // Search apart at the bar's end. The full-size photo hides it.
      row role="tablist" display=(top(nav).name == "photo" ? "none" : "flex") accent-color="accent" testId="tabs"
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=pick("home") testId="tab-home"
          image "symbol:home"
          text "Home"
        button role="tab" rel="search" aria-controls="panel-search" aria-selected=(nav.tab == "search") press=pick("search") testId="tab-search"
          image "symbol:search"
          text "Search"
      // The menu: every destination and the theme, slid in from the left.
      // A full-window dialog painting its own dim: iOS centres a top-layer dialog's box,
      // so the panel sits at its start and the dim beside it closes the menu.
      dialog id="drawer" width="100%" height="100%" background-color="drawer.dim" testId="drawer"
        ::backdrop
          background-color="transparent"
        row width="100%" height="100%"
          scroll width="18rem" max-width="85%" height="100%" background-color="surface.card" color="text.primary"
            accent-color="accent" animation="drawer-in 240ms ease-out"
            column padding="64px 0 24px"
              text "Browse" role="heading" aria-level=2 padding="0 24px 4px" color="text.muted" font-size=13 font-weight=600
              for l in ["now-playing", "coming-soon"] key=l
                button press=browse(l) testId=`browse-${l}` padding="12px 24px" text-align="start" width="100%" color="text.primary"
                  text releaseList(l)
              text "Lists" role="heading" aria-level=2 margin-top=20 padding="0 24px 4px" color="text.muted" font-size=13 font-weight=600
              button press=open(path("watchlist")) testId="open-watchlist" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "To Watch"
              button press=open(path("favorites")) testId="open-favorites" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "Favorites"
              button press=open(path("watched")) testId="open-watched" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "Watched"
              button press=open(path("playback")) testId="open-playback" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "Seen on Apple TV"
              text "Settings" role="heading" aria-level=2 margin-top=20 padding="0 24px 4px" color="text.muted" font-size=13 font-weight=600
              button press=open(path("services")) testId="open-services" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "My Services"
              // One row for the theme: its pop-up lists them all.
              row align-items="center" flex-wrap="wrap" column-gap=12 padding="8px 24px"
                text "Theme" flex=1
                select value=theme change=pickTheme aria-label="Theme" testId="theme" min-width=0
                  for t in ["rose-pine", "tokyo-night", "catppuccin", "classic"] key=t
                    option themeName(t) value=t
              button press=open(path("about")) testId="open-about" padding="12px 24px" text-align="start" width="100%" color="text.primary"
                text "About"
          button press=closeMenu aria-label="Close menu" testId="menu-close" flex=1 height="100%" appearance="none"

// The search screen's results or recently viewed pages: people as a strip of round
// portraits, then titles as a grid of posters.
component Shelves
  props
    prefix: string
    people: Tile[]
    titles: Tile[]
    peopleHeading: string
    titlesHeading: string
  view
    column gap=24 padding="8px 0 32px"
      if people.length > 0
        column gap=12
          text peopleHeading role="heading" aria-level=2 padding="0 16px" font="-exact-title3" font-weight=700
          scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none" width="100%"
            row gap=16 padding="0 16px" align-items="flex-start"
              for t in people key=`${t.kind}-${t.id}`
                TileLink(testId=`${prefix}-${t.kind}-${t.id}`, tile=t, width=84)
      if titles.length > 0
        column gap=12
          text titlesHeading role="heading" aria-level=2 padding="0 16px" font="-exact-title3" font-weight=700
          box display="grid" grid-template-columns="repeat(auto-fill, minmax(104px, 1fr))" column-gap=14 row-gap=20 padding="0 16px"
            for t in titles key=`${t.kind}-${t.id}`
              TileLink(testId=`${prefix}-${t.kind}-${t.id}`, tile=t, width=0)

// A search hit or recently viewed page as artwork with its name under it, linking to its
// title or person screen: a poster for a title, a round portrait for a person.
// `width` fixes a carousel's tile; 0 fills a grid's cell.
component TileLink
  props
    testId: string
    tile: Tile
    width: number
  derive kind = tile.kind
  derive id = tile.id
  derive label = tile.label
  derive picture = tile.picture
  derive year = tile.year
  view
    link href=(kind == "movie" ? path("movie", id) : kind == "tv" ? path("tv", id) : path("person", id))
      display="flex" flex-direction="column" gap=6 testId=testId flex-shrink=0
      width=(width == 0 ? "100%" : `${width}px`)
      aria-label=(year == "" ? `${label}, ${kindName(kind)}` : `${label}, ${kindName(kind)}, ${year}`)
      if picture == ""
        column width="100%" aspect-ratio=(kind == "person" ? "1" : "2 / 3") border-radius=(kind == "person" ? "50%" : "12px")
          background-color="surface.thumb" align-items="center" justify-content="center"
          image (kind == "person" ? "symbol:person" : "symbol:photo") color="text.muted" width=28 height=28
      else
        image picture aria-label="" width="100%" aspect-ratio=(kind == "person" ? "1" : "2 / 3")
          border-radius=(kind == "person" ? "50%" : "12px") object-fit="cover" background-color="surface.thumb"
      column gap=2 align-items=(kind == "person" ? "center" : "flex-start")
        text label font="-exact-subheadline" font-weight=600 line-clamp=2
          text-align=(kind == "person" ? "center" : "start")
        if kind != "person"
          text (year == "" ? kindName(kind) : `${kindName(kind)} · ${year}`) font="-exact-caption1" color="text.muted"

// A section of search results: each hit's artwork, name, type and year, and its
// overview or known-for line, as the web and macOS results show them, with In theaters
// on a movie playing now. A movie or show has To Watch and Favorite beside it; each
// waits for its list to be read (`toWatchKeys` and `favoriteKeys`), and all wait
// while a mark is saving.
component HitList
  props
    heading: string
    hits: Hit[]
    toWatchKeys: string[]
    favoriteKeys: string[]
    toWatchKnown: bool
    favoritesKnown: bool
    busy: bool
    toWatch: action
    favorite: action
  view
    column gap=12
      text heading role="heading" aria-level=2 padding="0 16px" font="-exact-title3" font-weight=700
      column gap=16 padding="0 16px"
        for h in hits key=`${h.kind}-${h.id}`
          HitRow(testId=`hit-${h.kind}-${h.id}`, tile=fromHit(h), summary=hitSummary(h), inTheaters=yes(h.in_theaters),
            onToWatch=toWatchKeys.includes(`${h.kind}-${h.id}`), onFavorites=favoriteKeys.includes(`${h.kind}-${h.id}`),
            toWatchKnown=toWatchKnown, favoritesKnown=favoritesKnown, busy=busy, toWatch=toWatch, favorite=favorite)

component HitRow
  props
    testId: string
    tile: Tile
    summary: string
    inTheaters: bool
    onToWatch: bool
    onFavorites: bool
    toWatchKnown: bool
    favoritesKnown: bool
    busy: bool
    toWatch: action
    favorite: action
  derive kind = tile.kind
  derive id = tile.id
  derive year = tile.year
  view
    row align-items="flex-start" gap=8
      link href=(kind == "movie" ? path("movie", id) : kind == "tv" ? path("tv", id) : path("person", id))
        display="flex" align-items="flex-start" gap=12 flex=1 min-width=0 testId=testId
        aria-label=[tile.label, kindName(kind), year, inTheaters ? "in theaters" : ""].filter(x => x != "").join(", ")
        if tile.picture == ""
          column width=60 height=(kind == "person" ? 60 : 90) flex-shrink=0 border-radius=(kind == "person" ? "50%" : "8px")
            background-color="surface.thumb" align-items="center" justify-content="center"
            image (kind == "person" ? "symbol:person" : "symbol:photo") color="text.muted" width=22 height=22
        else
          image tile.picture aria-label="" width=60 height=(kind == "person" ? 60 : 90) flex-shrink=0
            border-radius=(kind == "person" ? "50%" : "8px") object-fit="cover" background-color="surface.thumb"
        column flex=1 min-width=0 gap=2
          text tile.label font="-exact-subheadline" font-weight=600 line-clamp=2
          text (year == "" ? kindName(kind) : `${kindName(kind)} · ${year}`) font="-exact-caption1" color="text.muted"
          if inTheaters
            text "In theaters" font="-exact-caption1" color="accent" testId=`${testId}-in-theaters`
          if summary != ""
            text summary font="-exact-footnote" color="text.muted" line-clamp=3 testId=`${testId}-summary`
      if kind != "person"
        column gap=4 flex-shrink=0
          button press=toWatch(kind, id, not onToWatch) aria-pressed=onToWatch disabled=(busy or not toWatchKnown)
            aria-label=`To Watch: ${tile.label}` testId=`${testId}-to-watch` padding=8
            image (onToWatch ? "symbol:bookmark-fill" : "symbol:bookmark") color="accent" width=22 height=22
              testId=`${testId}-to-watch-${onToWatch ? "on" : "off"}`
          button press=favorite(kind, id, not onFavorites) aria-pressed=onFavorites disabled=(busy or not favoritesKnown)
            aria-label=`Favorite: ${tile.label}` testId=`${testId}-favorite` padding=8
            image (onFavorites ? "symbol:heart-fill" : "symbol:heart") color=(onFavorites ? "mark.favorite" : "accent") width=22 height=22
              testId=`${testId}-favorite-${onFavorites ? "on" : "off"}`

component Thumb
  props
    url: string
  view
    if url == ""
      column width=46 height=69 border-radius=6 background-color="surface.thumb"
    else
      image url aria-label="" width=46 height=69 border-radius=6 object-fit="cover"

component TitleScreen
  props
    navKey: string
    kind: string
    id: string
  resource t = title(kind, id) as shape Title
  action retry
    refresh t
  // The last mark's reply is the server's marks after it, shown until the screen
  // closes; the title is read again too, since favoriting a show marks its seasons.
  mutation marked as shape Marks queue refreshes t
  derive marks = match marked { case some(m) => m, case none => t.marks }
  action toggleToWatch
    send marked = setToWatch(kind, id, not yes(marks.to_watch))
  action toggleFavorite
    send marked = setFavorite(kind, id, not yes(marks.favorite))
  action toggleWatched
    send marked = setWatched(kind, id, not yes(marks.watched))
  // Recommended-by tags, while it's on To watch: each change replaces them all and
  // the title is read again for the tags as saved.
  state draft = ""
  mutation tagged as shape SourceTags queue refreshes t then afterTag
  resource known = watchlistSources() when yes(marks.to_watch) as shape SourceTags
  derive suggestions = current(known) and current(t) ? tagSuggestions(known.sources, sourceList(t.sources)) : []
  action editDraft(v: string)
    draft = v
  action addTyped
    if typedTags(draft).length > 0 and not pending(tagged)
      send tagged = setSources(kind, id, sourceList(t.sources).concat(typedTags(draft)))
  action addTag(name: string)
    if not pending(tagged)
      send tagged = setSources(kind, id, sourceList(t.sources).concat([name]))
  action removeTag(name: string)
    if not pending(tagged)
      send tagged = setSources(kind, id, sourceList(t.sources).filter(x => x != name))
  action afterTag
    draft = ""
  view
    column navigationKey=navKey navigationScroll="title" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text (current(t) ? t.title : "") role="heading" aria-level=2 testId="title"
      if failed(t)
        EmptyState(symbol="symbol:alert", title="Can’t Load Title", message="The server didn’t answer.")
          button press=retry testId="title-retry"
            text "Try Again"
      else if not current(t)
        progress aria-label="Loading" testId="loading"
      else
        list id="title" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          if staleNote(t.metadata) != ""
            section
              Notice(testId="stale", message=staleNote(t.metadata))
          section
            if text(t.backdrop_url) != ""
              link href=photoPath(text(t.backdrop_url)) aria-label=`Backdrop for ${t.title}, full size` testId="backdrop"
                background-color="surface.card"
                image text(t.backdrop_url) aria-label="" width="100%" aspect-ratio="16 / 9" border-radius=8 object-fit="cover"
            row gap=16 align-items="flex-start" padding-top=12 padding-bottom=12 background-color="surface.card"
              if text(t.poster_url) == ""
                column width=110 height=165 border-radius=8 background-color="surface.thumb"
              else
                link href=photoPath(text(t.poster_url)) aria-label=`Poster for ${t.title}, full size` testId="poster"
                  image text(t.poster_url) aria-label="" width=110 height=165 border-radius=8 object-fit="cover"
              column flex=1 min-width=0 gap=6
                text titleFacts(t) color="text.muted" testId="title-facts"
                if theatersOf(t)
                  text "In theaters" font="-exact-footnote" color="accent" testId="in-theaters"
                if ratingsNote(t.ratings) != ""
                  text ratingsNote(t.ratings) font="-exact-footnote" color="text.muted" role="status" testId="ratings-note"
                if yes(marks.favorite)
                  text "★ Favorite" color="mark.favorite" testId="favorite-badge"
                if unknown(marks.favorite)
                  text "Favorites couldn’t be read. Please reload to try again." font="-exact-footnote" color="text.muted"
                    role="status" testId="favorites-note"
                if text(t.showtimes_url) != ""
                  link href=text(t.showtimes_url) testId="showtimes"
                    text "Showtimes"
                if text(t.tagline) != ""
                  text text(t.tagline) font="-exact-footnote" color="text.muted"
            if hasScores(t.ratings)
              RatingRings(ratings=t.ratings)
            if text(t.overview) != ""
              text text(t.overview) padding-top=8 padding-bottom=8 testId="overview" background-color="surface.card"
            for k in keyCrewOf(t) key=k.role
              column gap=2 padding-top=6 padding-bottom=6 testId=`crew-${k.role}` background-color="surface.card"
                text keyRole(k.role) font="-exact-footnote" color="text.muted"
                text k.people.map(p => p.name).join(", ")
          section
            MarkButtons(marks=marks, busy=pending(marked), failed=(failed(marked) and not pending(marked)),
              toWatch=toggleToWatch, favorite=toggleFavorite, watched=toggleWatched)
          if yes(marks.to_watch)
            section testId="sources"
              header
                text "Recommended By"
              for name in sourceList(t.sources) key=name
                row gap=8 align-items="center" background-color="surface.card" testId=`source-${name}`
                  text `#${name}` flex=1 min-width=0
                  button press=removeTag(name) disabled=pending(tagged) aria-label=`Remove #${name}` testId=`source-remove-${name}`
                    image "symbol:close" color="text.muted"
              row gap=8 align-items="center" background-color="surface.card"
                input value=draft input=editDraft submit=addTyped autocapitalize="none" autocorrect="off" spellcheck="false"
                  enterkeyhint="done" placeholder=(sourceList(t.sources).length == 0 ? "#who-or-what" : "#more")
                  aria-label="Tag who or what recommended it" testId="source-draft" flex=1 min-width=0
                button press=addTyped disabled=(typedTags(draft).length == 0 or pending(tagged)) testId="source-add"
                  text "Add"
              if suggestions.length > 0
                row gap=8 flex-wrap="wrap" background-color="surface.card" testId="source-suggestions"
                  for name in suggestions key=name
                    button press=addTag(name) buttonStyle="bordered" disabled=pending(tagged) aria-label=`Add #${name}` testId=`source-suggest-${name}`
                      text `#${name}`
              if failed(tagged) and not pending(tagged)
                text "Couldn’t save the tags. Try again." color="mark.favorite" background-color="surface.card" testId="source-error"
              footer
                text "Separate tags with spaces." testId="source-hint"
          match t.where_to_watch
            case some(w)
              WhereToWatchSection(w=w, inTheaters=theatersOf(t))
            case none
          match t.releases
            case some(r)
              ReleaseSection(info=r)
            case none
          if seasonsOf(t).length > 0
            section
              header
                text "Seasons"
              for s in seasonsOf(t) key=`${s.number}`
                link href=path("season", id, `${s.number}`) testId=`season-${s.number}` background-color="surface.card"
                  text s.name flex=1
                  text `${s.episode_count} ${s.episode_count == 1 ? "episode" : "episodes"}` color="text.muted"
                  image "symbol:forward-chevron" color="text.muted"
          section
            header
              text "Cast"
            for c in t.cast.slice(0, 10) key=`${c.person_id}`
              link href=path("person", `${c.person_id}`) display="flex" align-items="center" gap=12
                testId=`title-cast-${c.person_id}` background-color="surface.card"
                image text(c.profile_url) aria-label="" width=40 height=40 border-radius=999 object-fit="cover"
                column flex=1 min-width=0
                  text c.name
                  text creditLine("", c) font="-exact-footnote" color="text.muted"
                image "symbol:forward-chevron" color="text.muted"
            if moreCredits(t)
              link href=(kind == "movie" ? path("movieCredits", id) : path("tvCredits", id)) testId="full-credits" background-color="surface.card"
                text "Full Cast & Crew" flex=1
                text `${countOf(t.cast_total)} cast, ${countOf(t.crew_total)} crew` color="text.muted"
                image "symbol:forward-chevron" color="text.muted"

// A title's whole cast, then its crew a department to a section, as the web's
// credits page lists them.
component CreditsScreen
  props
    navKey: string
    kind: string
    id: string
  resource c = credits(kind, id) as shape Credits
  action retry
    refresh c
  view
    column navigationKey=navKey navigationScroll="credits" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text (current(c) ? `${c.title}: Cast & Crew` : "") role="heading" aria-level=2 testId="credits-title"
      if failed(c)
        EmptyState(symbol="symbol:alert", title="Can’t Load Cast & Crew", message="The server didn’t answer.")
          button press=retry testId="credits-retry"
            text "Try Again"
      else if not current(c)
        progress aria-label="Loading"
      else if c.cast.length == 0 and c.crew.length == 0
        EmptyState(symbol="symbol:person", title="No Cast or Crew", message="TMDB has no one listed for this title.")
      else
        list id="credits" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          if c.cast.length > 0
            section
              header
                text `Cast · ${c.cast.length}`
              for p in c.cast key=`${p.person_id}`
                Credit(testId=`cast-${p.person_id}`, person=p, line=creditLine("as ", p))
          for d in c.crew key=d.name
            section
              header
                text `${d.name} · ${d.people.length}`
              for p in d.people key=`${p.person_id}`
                Credit(testId=`${d.name}-${p.person_id}`, person=p, line=creditLine("", p))

component Credit
  props
    testId: string
    person: CastMember
    line: string
  view
    link href=path("person", `${person.person_id}`) display="flex" align-items="center" gap=12 testId=testId background-color="surface.card"
      if text(person.profile_url) == ""
        column width=40 height=40 border-radius=999 background-color="surface.thumb"
      else
        image text(person.profile_url) aria-label="" width=40 height=40 border-radius=999 object-fit="cover"
      column flex=1 min-width=0
        text person.name
        if line != ""
          text line font="-exact-footnote" color="text.muted"
      image "symbol:forward-chevron" color="text.muted"

// The title's offers in the region, grouped as stream, rent and buy, with the
// user's services marked. Says when the offers couldn't be loaded or refreshed
// rather than showing an empty or silently old list, as the web's section does.
component WhereToWatchSection
  props
    w: WhereToWatch
    inTheaters: bool
  view
    section testId="where-to-watch"
      header
        text `Where to Watch in ${w.region}`
      if w.offers.length == 0
        if w.state == "unavailable"
          row gap=8 background-color="surface.card" testId="where-unavailable"
            image "symbol:alert" color="text.muted"
            text "Where to watch couldn’t be loaded right now." color="text.muted" flex=1
        else if inTheaters
          text `In theaters. Not streaming or for rent or sale in ${w.region} yet.` background-color="surface.card" testId="where-in-theaters"
        else
          text `No streaming, rental or purchase options are listed for ${w.region}.` color="text.muted"
            background-color="surface.card" testId="where-none"
      else
        if myServices(w).length > 0
          row gap=8 background-color="surface.card" testId="where-mine"
            image "symbol:checkmark" color="accent"
            text `On your services: ${myServices(w).join(", ")}` color="accent" flex=1
        for g in w.offers key=g.kind
          column gap=8 padding-top=10 padding-bottom=10 background-color="surface.card" testId=`offers-${g.kind}`
            text offerLabel(g.kind) font="-exact-footnote" color="text.muted"
            row flex-wrap="wrap" gap=12
              for p in g.providers key=`${p.id}`
                Provider(p=p)
      if w.state == "stale"
        text (listedOn(w) == "" ? "Couldn’t refresh where to watch." : `Couldn’t refresh where to watch; showing what was listed on ${listedOn(w)}.`)
          font="-exact-footnote" color="text.muted" background-color="surface.card" testId="where-stale"
      if w.offers.length > 0 and w.my_services == "unreadable"
        text "Your services couldn’t be read, so none are highlighted." font="-exact-footnote" color="text.muted"
          background-color="surface.card" testId="services-unreadable"
      else if w.offers.length > 0 and w.my_services == "not_chosen"
        text "Choose your streaming services to highlight them here." font="-exact-footnote" color="text.muted"
          background-color="surface.card" testId="services-not-chosen"
      if w.state != "unavailable"
        match w.link
          case some(u)
            link href=u background-color="surface.card" testId="where-link"
              text "All options on TMDB" flex=1
              image "symbol:forward-chevron" color="text.muted"
          case none
            text "Availability from JustWatch" font="-exact-footnote" color="text.muted" background-color="surface.card"

// A service's logo and name; one of the user's services is ringed and checked.
component Provider
  props
    p: WatchProvider
  view
    column width="4.5rem" align-items="center" gap=4 testId=(p.mine ? `provider-${p.id}-mine` : `provider-${p.id}`)
      image text(p.logo_url) aria-label="" width=44 height=44 border-radius=10 object-fit="cover"
        border=(p.mine ? "2px solid var(--accent)" : "none")
      row gap=2 align-items="center" justify-content="center"
        if p.mine
          image "symbol:checkmark" color="accent" font="-exact-caption-1" aria-label="Your service"
        text p.name font="-exact-caption-1" text-align="center" color=(p.mine ? "accent" : "text.primary")

// A movie's release dates in the server's region, then its rating there, as the
// web's detail list shows them.
component ReleaseSection
  props
    info: TitleReleases
  view
    section testId="title-releases"
      header
        text `Release · ${info.region}`
      for d in info.dates key=d.kind
        row gap=12 background-color="surface.card" testId=`release-${d.kind}`
          text releaseLabel(d) flex=1
          text releaseDay(d) color=(d.upcoming ? "accent" : "text.muted")
      match info.certification
        case some(c)
          row gap=12 background-color="surface.card" testId="certification"
            text "Rated" flex=1
            text c color="text.muted"
        case none

// A title's scores, preferred first and larger, each a ring beside its source
// and note, as the web's title page lays them out.
component RatingRings
  props
    ratings: Ratings
  view
    row flex-wrap="wrap" align-items="center" gap="10px 28px" padding-top=12 padding-bottom=12
      testId="ratings" background-color="surface.card"
      match ratings.preferred
        case some(p)
          RatedSource(score=p, size=48)
        case none
      for o in othersOf(ratings) key=o.source
        RatedSource(score=o, size=36)

component RatedSource
  props
    score: Score
    size: number
  view
    row gap=12 align-items="center" testId=`score-${score.source}`
      ScoreRing(score=score, size=size)
      column min-width=0
        text sourceName(score) font="-exact-subheadline"
        text scoreNote(score) font="-exact-footnote" color="text.muted"

// The web's score ring: a circle filled to the score's percent in its source's
// colour, the percent inside and the source's mark on its corner. One image to
// a reader, named "Rotten Tomatoes: Fresh, 83%" or "IMDb, 8.7/10".
component ScoreRing
  props
    score: Score
    size: number
  view
    column role="img" aria-label=ringLabel(score) position="relative" flex="none"
      width=size height=size align-items="center" justify-content="center"
      svg viewBox="0 0 100 100" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
        circle cx=50 cy=50 r=44 fill="none" stroke="surface.thumb" stroke-width=12
        if ringPercent(score) > 0
          circle cx=50 cy=50 r=44 fill="none" stroke=tone(score) stroke-width=12
            pathLength=100 stroke-dasharray=`${ringPercent(score)} 100` transform="rotate(-90 50 50)"
      column position="absolute" inset=0 align-items="center" justify-content="center"
        text `${ringPercent(score)}` font-size=(size * 0.4) font-weight=700
          font-variant-numeric="tabular-nums" white-space="nowrap" aria-hidden=true
      if isTomatometer(score)
        svg viewBox="0 0 32 32" position="absolute" right=(size * -0.16) bottom=(size * -0.12)
          width=(size * 0.45) height=(size * 0.45) aria-hidden=true
          if fresh(score)
            ellipse cx=16 cy=18.6 rx=14.4 ry=12.6 fill="score.fresh"
            path d="M16 4.64 L16.94 7.89 L22.85 7.38 L17.52 8.87 L20.23 11.8 L16 9.48 L11.77 11.8 L14.48 8.87 L9.15 7.38 L15.06 7.89Z"
              fill="score.stem" stroke="score.stem" stroke-width=1.2 stroke-linejoin="round"
            path d="M16 8.4c0-2.4.8-4.4 2.4-6" fill="none" stroke="score.stem" stroke-width=2 stroke-linecap="round"
          else
            path d="M27 14.11 Q28.2 16.6 25.47 18.19 Q22.74 19.78 23.9 24.25 Q25.06 28.71 20.99 26.38 Q16.91 24.05 14.01 25.87 Q11.12 27.7 10.7 24.38 Q10.29 21.05 6.13 20.65 Q1.97 20.25 4.91 17.31 Q7.85 14.38 7.35 10.96 Q6.85 7.54 10.15 9.11 Q13.45 10.68 15.81 6.32 Q18.18 1.96 19.56 6.09 Q20.95 10.23 23.37 10.93 Q25.79 11.63 27 14.11Z"
              fill="score.rotten"
            circle cx=28.4 cy=9.4 r=1.8 fill="score.rotten"
            circle cx=3 cy=25.2 r=1.5 fill="score.rotten"
      else
        column position="absolute" right=(size * -0.26) bottom=(size * -0.12)
          width=(size * 0.56) height=(size * 0.28) border-radius=(size * 0.04)
          align-items="center" justify-content="center" background-color="score.imdb" aria-hidden=true
          text "IMDb" font-size=(size * 0.17) font-weight=900 color="score.imdb-ink" white-space="nowrap"

// A season's episodes. An episode not yet watched keeps its summary, score and
// still blurred, as the web's spoiler guard does; tapping its summary peeks at
// them until it's tapped again or another episode is peeked at.
component SeasonScreen
  props
    navKey: string
    id: string
    n: string
  resource s = season(id, n) as shape Season
  action retry
    refresh s
  state peekEp = -1
  // As on TitleScreen, the last mark's reply is the show's watched marks after it.
  mutation marked as shape SeasonWatched queue refreshes s
  derive w = match marked { case some(m) => m, case none => s.watched }
  action toggleSeason
    send marked = setSeasonWatched(id, n, not seasonSeen(w, s.number))
  action toggleEpisode(ep: number)
    send marked = setEpisodeWatched(id, n, ep, not seen(w, s.number, ep))
  action peekAt(ep: number)
    peekEp = peekEp == ep ? -1 : ep
  view
    column navigationKey=navKey navigationScroll="season" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text (current(s) ? `${s.show_title}: ${s.name}` : "") role="heading" aria-level=2 testId="season-title"
      if failed(s)
        EmptyState(symbol="symbol:alert", title="Can’t Load Season", message="The server didn’t answer.")
          button press=retry testId="season-retry"
            text "Try Again"
      else if not current(s)
        progress aria-label="Loading"
      else
        list id="season" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          if staleNote(s.metadata) != "" or stateOf(s.watched.state) == "unreadable"
            section
              if staleNote(s.metadata) != ""
                Notice(testId="stale", message=staleNote(s.metadata))
              if stateOf(s.watched.state) == "unreadable"
                Notice(testId="watched-note", message="Watched marks couldn’t be read, so every episode stays blurred.")
          section
            row gap=8 align-items="center" background-color="surface.card"
              text (w.show ? "Watched with the whole show" : seasonSeen(w, s.number) ? "Season watched" : "Season not watched")
                flex=1 color="text.muted" testId="season-state"
              button press=toggleSeason buttonStyle="bordered" aria-pressed=seasonSeen(w, s.number)
                disabled=pending(marked) testId="mark-season"
                text (seasonSeen(w, s.number) ? "Unmark Season" : "Mark Season Watched")
            if failed(marked) and not pending(marked)
              text "Couldn’t save the mark. Try again." font="-exact-footnote" color="mark.favorite"
                background-color="surface.card" testId="mark-error"
          if s.previous != none or s.next != none
            section
              match s.previous
                case some(p)
                  link href=path("season", id, `${p.number}`) testId="previous-season" background-color="surface.card"
                    image "symbol:back" color="text.muted"
                    text p.name flex=1
                case none
              match s.next
                case some(x)
                  link href=path("season", id, `${x.number}`) testId="next-season" background-color="surface.card"
                    text x.name flex=1
                    image "symbol:forward-chevron" color="text.muted"
                case none
          section
            for ep in s.episodes key=`${ep.number}`
              column gap=6 padding-top=10 padding-bottom=10 testId=`episode-${ep.number}` background-color="surface.card"
                row gap=8
                  link href=path("episode", id, n, `${ep.number}`) testId=`episode-open-${ep.number}` flex=1
                    text `${ep.number}. ${ep.title}` font="-exact-headline"
                  match ep.rating
                    case some(r)
                      column testId=`rating-${ep.number}`
                        filter=(seen(w, s.number, ep.number) or peekEp == ep.number ? "none" : "blur(5px)")
                        ScoreRing(score=r, size=28)
                    case none
                  button press=toggleEpisode(ep.number) aria-pressed=seen(w, s.number, ep.number)
                    aria-label=`Episode ${ep.number} watched` disabled=pending(marked)
                    testId=`mark-episode-${ep.number}`
                    if seen(w, s.number, ep.number)
                      text "Watched" font="-exact-footnote" color="mark.watched"
                    else
                      text "Mark Watched" font="-exact-footnote"
                text listedEpisodeFacts(ep, fromAppleTv(w, s.number, ep.number)) font="-exact-footnote" color="text.muted" testId=`episode-facts-${ep.number}`
                // A watched episode's still opens full size; an unwatched one stays
                // blurred and shut, so the spoiler guard holds.
                if seen(w, s.number, ep.number) and text(ep.still_url) != ""
                  link href=photoPath(text(ep.still_url)) aria-label=`Still from ${ep.title}, full size` testId=`still-${ep.number}`
                    image text(ep.still_url) aria-label="" width="100%" aspect-ratio="16 / 9" border-radius=8 object-fit="cover"
                else
                  image text(ep.still_url) aria-label="" width="100%" aspect-ratio="16 / 9" border-radius=8 object-fit="cover"
                    filter=(seen(w, s.number, ep.number) or peekEp == ep.number ? "none" : "blur(14px)")
                if seen(w, s.number, ep.number) or text(ep.overview) == ""
                  text text(ep.overview) font="-exact-subheadline" testId=`overview-${ep.number}`
                else
                  button press=peekAt(ep.number) aria-pressed=(peekEp == ep.number) text-align="start"
                    aria-label=(peekEp == ep.number ? text(ep.overview) : `Episode ${ep.number} summary, hidden. Peek`)
                    testId=`peek-${ep.number}`
                    text text(ep.overview) font="-exact-subheadline" color="text.primary"
                      filter=(peekEp == ep.number ? "none" : "blur(5px)")
                      testId=`overview-${ep.number}`

// To watch, Favorite and Watched on a movie or show, as the web's detail page
// toggles them. Each press flips one mark; the screen re-reads the title after.
component MarkButtons
  props
    marks: Marks
    busy: bool
    failed: bool
    toWatch: action
    favorite: action
    watched: action
  view
    column gap=8 padding-top=8 padding-bottom=8 background-color="surface.card"
      row gap=8 flex-wrap="wrap"
        button press=toWatch buttonStyle="bordered" aria-pressed=yes(marks.to_watch) disabled=busy testId="mark-to-watch"
          image (yes(marks.to_watch) ? "symbol:bookmark-fill" : "symbol:bookmark")
          text "To Watch"
        button press=favorite buttonStyle="bordered" aria-pressed=yes(marks.favorite) disabled=busy testId="mark-favorite"
          image (yes(marks.favorite) ? "symbol:heart-fill" : "symbol:heart")
          text "Favorite"
        button press=watched buttonStyle="bordered" aria-pressed=yes(marks.watched) disabled=busy testId="mark-watched"
          image (yes(marks.watched) ? "symbol:checkmark" : "symbol:circle")
          text "Watched"
      if failed
        text "Couldn’t save the mark. Try again." font="-exact-footnote" color="mark.favorite" testId="mark-error"

// Now Playing or Coming Soon: one request per page of twenty, and More adds the
// next below the last, as the web's Load More does.
component ReleasesScreen
  props
    navKey: string
    list: string
    loaded: Releases[]
    pages: number
    pending: bool
    failed: bool
    more: action
    retry: action
  derive movies = loaded.map(p => p.titles).flat()
  derive lastPage = match loaded.at(0) { case some(p) => p.total_pages, case none => 1 }
  view
    column navigationKey=navKey navigationScroll="releases" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text releaseList(list) role="heading" aria-level=2 testId="releases-title"
      if failed and movies.length == 0
        EmptyState(symbol="symbol:alert", title=`Can’t Load ${releaseList(list)}`, message="The server didn’t answer.")
          button press=retry testId="retry"
            text "Try Again"
      else if movies.length == 0 and pending
        progress aria-label="Loading" testId="loading"
      else if movies.length == 0
        EmptyState(symbol="symbol:calendar", title="No Movies", message=(list == "coming-soon" ? "Nothing is coming to theaters soon." : "Nothing is playing in theaters."))
      else
        list id="releases" testId="releases" appearance="auto" listStyle="plain" flex=1 min-height=0 background-color="surface.page"
          section
            for r in movies key=`${r.id}`
              link href=path("movie", `${r.id}`) display="flex" align-items="center" gap=12 testId=`release-${r.id}`
                background-color="surface.page"
                Thumb(url=text(r.poster_url))
                column flex=1 min-width=0
                  text r.title
                  text releaseLine(r) font="-exact-footnote" color="text.muted"
                image "symbol:forward-chevron" color="text.muted"
          section
            if pending
              progress aria-label="Loading more" background-color="surface.page"
            else if failed
              button press=retry testId="retry-more" background-color="surface.page"
                text "Couldn’t load more. Try Again"
            else if pages < lastPage
              button press=more testId="more" background-color="surface.page"
                text "More"

fn groupName(g: string): string = g == "mine" ? "Your Services" : g == "popular" ? "Popular" : "More Services"
fn chosenNames(s: Services): string = s.chosen.map(c => c.name).join(", ")

// Choose the streaming services you subscribe to, as the web's services page
// does; where to watch highlights them. Each switch saves at once: the reply is
// the new page, and until it lands the flipped switch shows what was asked.
component ServicesScreen
  props
    navKey: string
  resource svc = services() as shape Services
  mutation chose as shape Services queue
  state flipId = -1
  state flipOn = false
  derive page = match chose { case some(r) => r, case none => svc }
  action retry
    refresh svc
  action choose(id: number, on: bool)
    flipId = id
    flipOn = on
    send chose = chooseService(id, on)
  view
    column navigationKey=navKey navigationScroll="services" position="absolute" inset=0
      display="flex" flex-direction="column" background-color="surface.page"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text "My Services" role="heading" aria-level=2 testId="services-title"
      if failed(svc)
        EmptyState(symbol="symbol:alert", title="Can’t Load Services", message="The server didn’t answer.")
          button press=retry testId="services-retry"
            text "Try Again"
      else if not current(svc)
        progress aria-label="Loading" testId="services-loading"
      else
        list id="services" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          section
            text (page.chosen.length == 0 ? "No services chosen yet." : `Your services: ${chosenNames(page)}.`)
              background-color="surface.card" testId="services-status"
            if failed(chose) and not pending(chose)
              text "Couldn’t save your services. Try again." color="mark.favorite" background-color="surface.card" testId="services-error"
            if page.state == "unavailable"
              text (page.chosen.length == 0 ? "TMDB’s list of services couldn’t be loaded right now." : "TMDB’s list of services couldn’t be loaded right now, so only your services are listed. You can still remove them.")
                font="-exact-footnote" color="text.muted" background-color="surface.card" testId="services-unavailable"
            else if page.state == "stale"
              text "Couldn’t refresh TMDB’s list of services; showing an older copy."
                font="-exact-footnote" color="text.muted" background-color="surface.card" testId="services-stale"
            if not page.complete and page.state != "unavailable"
              text "Only part of TMDB’s list of services could be loaded, so some may be missing."
                font="-exact-footnote" color="text.muted" background-color="surface.card" testId="services-partial"
            footer
              text `Movie and TV pages highlight these in ${page.region}.`
          for g in ["mine", "popular", "more"] key=g
            if page.options.filter(o => o.group == g).length > 0
              section
                header
                  text groupName(g)
                for o in page.options.filter(o => o.group == g) key=`${o.id}`
                  row gap=12 background-color="surface.card"
                    if text(o.logo_url) == ""
                      column width=32 height=32 border-radius=6 background-color="surface.thumb"
                    else
                      image text(o.logo_url) aria-label="" width=32 height=32 border-radius=6 object-fit="cover"
                    text o.name flex=1
                    input type="checkbox" switch change=choose(o.id) aria-label=o.name
                      checked=(pending(chose) and flipId == o.id ? flipOn : o.chosen)
                      testId=`service-${o.id}`

// A person: photo, known for, born and died, a biography that opens past its first
// paragraph, known-for titles and the filmography by department in the web's Date or
// Rating order, each credit linking to its title. The filmography shows All, Movies or
// TV, counting each, and each credit has To Watch and Favorite beside it, as on the
// web; each waits for its list to be read (`toWatchKeys`, `favoriteKeys`), and all
// wait while a mark is saving.
component PersonScreen
  props
    navKey: string
    id: string
    toWatchKeys: string[]
    favoriteKeys: string[]
    toWatchKnown: bool
    favoritesKnown: bool
    busy: bool
    markFailed: bool
    toWatch: action
    favorite: action
  state sort = "date"
  state kind = "all"
  state more = false
  resource p = person(id, sort) as shape Person
  action retry
    refresh p
  action pickSort(s: string)
    sort = s
  action pickKind(k: string)
    kind = k
  action toggleMore
    more = not more
  view
    column navigationKey=navKey navigationScroll="person" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text (p.id > 0 ? p.name : "") role="heading" aria-level=2 testId="person-name"
      if failed(p) and p.id == 0
        EmptyState(symbol="symbol:alert", title="Can’t Load Person", message="The server didn’t answer.")
          button press=retry testId="person-retry"
            text "Try Again"
      else if p.id == 0
        progress aria-label="Loading" testId="loading"
      else
        list id="person" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          section
            row gap=16 align-items="flex-start" padding-top=12 padding-bottom=12 background-color="surface.card"
              if text(p.profile_url) == ""
                column width=110 height=165 border-radius=8 background-color="surface.thumb" role="img" aria-label="No photo available"
              else
                link href=photoPath(text(p.profile_url)) aria-label=`Photo of ${p.name}, full size` testId="person-photo"
                  image text(p.profile_url) aria-label="" width=110 height=165 border-radius=8 object-fit="cover"
              column flex=1 min-width=0 gap=6
                if text(p.known_for) != ""
                  text `Known for ${text(p.known_for)}` font="-exact-headline" testId="known-for"
                if bornText(p) != ""
                  text `Born ${bornText(p)}` color="text.muted" testId="born"
                if p.deathday != none
                  text `Died ${formatDate(text(p.deathday), 0, "medium")}` color="text.muted" testId="died"
            if paragraphs(p.biography).length == 0
              text "No biography available." color="text.muted" background-color="surface.card" testId="no-bio"
            else
              for para, i in (more ? paragraphs(p.biography) : paragraphs(p.biography).slice(0, 1)) key=`${i}`
                text para padding-top=8 padding-bottom=8 background-color="surface.card" testId=`bio-${i}`
              if paragraphs(p.biography).length > 1
                button press=toggleMore testId="more" background-color="surface.card"
                  text (more ? "Show less" : "Show more")
          if p.known_for_titles.length > 0
            section
              header
                text "Known For"
              for c in p.known_for_titles key=`${c.kind}-${c.id}`
                FilmRow(c=c, acting=true, prefix="known", chevron=true)
          if p.filmography.length == 0
            section
              text "TMDB has no credits listed for this person." color="text.muted" background-color="surface.card" testId="no-credits"
          else
            section
              header
                text "Filmography"
              row gap=8 align-items="center" background-color="surface.card"
                row role="radiogroup" aria-label="Sort credits" flex=1
                  button role="radio" aria-checked=(sort == "date") press=pickSort("date") testId="sort-date" flex=1
                    text "Date"
                  button role="radio" aria-checked=(sort == "rating") press=pickSort("rating") testId="sort-rating" flex=1
                    text "Rating"
                if not current(p)
                  progress aria-label="Sorting" testId="sorting"
              row gap=8 align-items="center" background-color="surface.card"
                row role="radiogroup" aria-label="Show credits" flex=1
                  button role="radio" aria-checked=(kind == "all") press=pickKind("all") testId="kind-all" flex=1
                    text `All ${creditCount(p, "all")}`
                  button role="radio" aria-checked=(kind == "movie") press=pickKind("movie") testId="kind-movie" flex=1
                    text `Movies ${creditCount(p, "movie")}`
                  button role="radio" aria-checked=(kind == "tv") press=pickKind("tv") testId="kind-tv" flex=1
                    text `TV ${creditCount(p, "tv")}`
              if not toWatchKnown or not favoritesKnown
                text `${not toWatchKnown and not favoritesKnown ? "To Watch and Favorites" : not toWatchKnown ? "To Watch" : "Favorites"} couldn’t be read yet, so ${not toWatchKnown and not favoritesKnown ? "their" : "its"} buttons wait.`
                  font="-exact-footnote" color="text.muted" background-color="surface.card" testId="marks-unread"
              if markFailed
                text "Couldn’t save the mark. Try again." font="-exact-footnote" color="mark.favorite"
                  background-color="surface.card" role="status" testId="credit-mark-error"
              if failed(p)
                text "Couldn’t load that order. Showing the last one." font="-exact-footnote" color="text.muted" background-color="surface.card" testId="sort-failed"
              else if ratingNote(p) != ""
                text ratingNote(p) font="-exact-footnote" color="text.muted" background-color="surface.card" testId="rating-note"
            if keptGroups(p, kind).length == 0
              section
                text `No ${kind == "tv" ? "TV" : "movie"} credits listed for this person.` color="text.muted"
                  background-color="surface.card" testId="no-kind-credits"
            for g in keptGroups(p, kind) key=g.department
              section
                header
                  text `${g.department} (${g.entries.length})`
                for c in g.entries key=`${c.kind}-${c.id}-${text(c.role)}`
                  row align-items="center" gap=4 background-color="surface.card"
                    FilmRow(c=c, acting=(g.department == "Acting"), prefix=g.department, chevron=false)
                    CreditMarks(testId=`${g.department}-${c.kind}-${c.id}`, kind=c.kind, id=`${c.id}`, label=c.title,
                      onToWatch=toWatchKeys.includes(`${c.kind}-${c.id}`), onFavorites=favoriteKeys.includes(`${c.kind}-${c.id}`),
                      toWatchKnown=toWatchKnown, favoritesKnown=favoritesKnown, busy=busy, toWatch=toWatch, favorite=favorite)

// A credit row on a person screen: poster, title, year, kind and role, and the score
// when sorted by rating. It links to the title's screen; a chevron says so when no
// toggles follow it.
component FilmRow
  props
    c: FilmCredit
    acting: bool
    prefix: string
    chevron: bool
  view
    link href=creditPath(c) display="flex" align-items="center" gap=12 flex=1 min-width=0
      testId=`${prefix}-${c.kind}-${c.id}` background-color="surface.card"
      Thumb(url=text(c.poster_url))
      column flex=1 min-width=0
        text c.title
        text filmLine(c, acting) font="-exact-footnote" color="text.muted"
      if creditScore(c.rating) != ""
        text creditScore(c.rating) font="-exact-footnote" color="text.muted" testId=`score-${c.kind}-${c.id}`
      if chevron
        image "symbol:forward-chevron" color="text.muted"

// A credit's To Watch and Favorite toggles, as on a search result.
component CreditMarks
  props
    testId: string
    kind: string
    id: string
    label: string
    onToWatch: bool
    onFavorites: bool
    toWatchKnown: bool
    favoritesKnown: bool
    busy: bool
    toWatch: action
    favorite: action
  view
    row gap=0 flex-shrink=0
      button press=toWatch(kind, id, not onToWatch) aria-pressed=onToWatch disabled=(busy or not toWatchKnown)
        aria-label=`To Watch: ${label}` testId=`${testId}-to-watch` padding=6
        image (onToWatch ? "symbol:bookmark-fill" : "symbol:bookmark") color="accent" width=22 height=22
          testId=`${testId}-to-watch-${onToWatch ? "on" : "off"}`
      button press=favorite(kind, id, not onFavorites) aria-pressed=onFavorites disabled=(busy or not favoritesKnown)
        aria-label=`Favorite: ${label}` testId=`${testId}-favorite` padding=6
        image (onFavorites ? "symbol:heart-fill" : "symbol:heart") color=(onFavorites ? "mark.favorite" : "accent") width=22 height=22
          testId=`${testId}-favorite-${onFavorites ? "on" : "off"}`

// A degraded-state notice at the top of a screen: data served stale from the
// cache, or a part that couldn't be read.
component Notice
  props
    testId: string
    message: string
  view
    row gap=10 align-items="flex-start" padding-top=10 padding-bottom=10 role="status" testId=testId
      background-color="surface.card"
      image "symbol:alert" color="text.muted"
      text message font="-exact-subheadline" flex=1 min-width=0

// An episode: still, air date, runtime, score, crew, overview, a pager to its
// neighbours, then guest stars and series cast. Until the episode is watched
// (itself, its season or the show) its still, score and summary stay blurred;
// Peek shows them until pressed again. Mark Watched flips the episode's own mark.
component EpisodeScreen
  props
    navKey: string
    id: string
    n: string
    e: string
  resource ep = episode(id, n, e) as shape EpisodeDetail
  action retry
    refresh ep
  // As on SeasonScreen, the last mark's reply is the show's watched marks after it.
  mutation marked as shape SeasonWatched queue refreshes ep
  state peek = false
  derive w = match marked { case some(m) => m, case none => ep.watched }
  derive watched = current(ep) and seen(w, ep.season_number, ep.number)
  derive shown = watched or peek
  action toggleWatched
    send marked = setEpisodeWatched(id, n, ep.number, not watched)
  action togglePeek
    peek = not peek
  view
    column navigationKey=navKey navigationScroll="episode" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text (current(ep) ? ep.title : "") role="heading" aria-level=2 testId="episode-title"
      if failed(ep)
        EmptyState(symbol="symbol:alert", title="Can’t Load Episode", message="The server didn’t answer.")
          button press=retry testId="episode-retry"
            text "Try Again"
      else if not current(ep)
        progress aria-label="Loading"
      else
        list id="episode" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          if staleNote(ep.metadata) != "" or stateOf(ep.watched.state) == "unreadable"
            section
              if staleNote(ep.metadata) != ""
                Notice(testId="stale", message=staleNote(ep.metadata))
              if stateOf(ep.watched.state) == "unreadable"
                Notice(testId="watched-note", message="Watched marks couldn’t be read, so the spoilers stay blurred.")
          section
            column gap=8 padding-top=12 padding-bottom=12 background-color="surface.card"
              if text(ep.still_url) == ""
                column width="100%" aspect-ratio="16 / 9" border-radius=8 background-color="surface.thumb"
              else if shown
                link href=photoPath(text(ep.still_url)) aria-label=`Still from ${ep.title}, full size` testId="still"
                  image text(ep.still_url) aria-label="" width="100%" aspect-ratio="16 / 9" border-radius=8 object-fit="cover"
              else
                image text(ep.still_url) aria-label=`Still from ${ep.title}` width="100%" aspect-ratio="16 / 9" border-radius=8 object-fit="cover"
                  filter="blur(14px)" testId="still"
              text `${ep.show_title} · ${ep.season_name} · Episode ${ep.number}` font="-exact-footnote" color="text.muted"
              row gap=8 flex-wrap="wrap"
                text episodeFacts(ep) color="text.muted" flex=1 flex-basis="10rem" testId="facts"
                if watched
                  text (fromAppleTv(w, ep.season_number, ep.number) ? "Watched on Apple TV" : "Watched")
                    font="-exact-footnote" color="mark.watched" testId="watched"
              text episodeScore(ep) font="-exact-headline" testId="episode-score"
                filter=(shown or scoreOf(ep.rating) == "" ? "none" : "blur(6px)")
              for k in ep.key_crew key=k.role
                text `${keyRole(k.role)} ${k.people.map(p => p.name).join(", ")}` font="-exact-footnote"
            if text(ep.overview) == ""
              text "No summary available." padding-top=8 padding-bottom=8 color="text.muted" background-color="surface.card"
            else
              text text(ep.overview) padding-top=8 padding-bottom=8 testId="episode-overview" background-color="surface.card"
                filter=(shown ? "none" : "blur(5px)")
          section
            row gap=8 align-items="center" flex-wrap="wrap" background-color="surface.card"
              button press=toggleWatched buttonStyle="bordered" aria-pressed=watched
                disabled=pending(marked) testId="mark-episode"
                image (watched ? "symbol:checkmark" : "symbol:circle")
                text "Watched"
              if not watched
                button press=togglePeek aria-pressed=peek testId="peek"
                  text (peek ? "Hide Spoilers" : "Peek at Spoilers")
            if failed(marked) and not pending(marked)
              text "Couldn’t save the mark. Try again." font="-exact-footnote" color="mark.favorite"
                background-color="surface.card" testId="mark-error"
          if ep.previous != none or ep.next != none
            section
              match ep.previous
                case some(p)
                  link href=path("episode", id, n, `${p}`) testId="previous" background-color="surface.card"
                    image "symbol:back" color="text.muted"
                    text `Episode ${p}` flex=1
                case none
              match ep.next
                case some(x)
                  link href=path("episode", id, n, `${x}`) testId="next" background-color="surface.card"
                    text `Episode ${x}` flex=1
                    image "symbol:forward-chevron" color="text.muted"
                case none
          section
            header
              text "Guest Stars"
            if ep.guest_stars.length == 0
              text "No guest stars listed." color="text.muted" background-color="surface.card"
            for c in ep.guest_stars key=`${c.person_id}`
              Credit(testId=`guest-${c.person_id}`, person=c, line=text(c.role))
          section
            header
              text "Series Cast"
            if ep.cast.length == 0
              text "No series regulars listed." color="text.muted" background-color="surface.card"
            for c in ep.cast key=`${c.person_id}`
              Credit(testId=`cast-${c.person_id}`, person=c, line=text(c.role))
// A poster, backdrop, photo or still full screen, over black, to pinch and zoom.
// The smaller copy already shown fills in until the original loads, or if it
// can't, as the web's lightbox does.
component PhotoScreen
  props
    navKey: string
    url: string
    close: action
  view
    column navigationKey=navKey navigationPresentation="fullscreen" navigationScroll="photo"
      position="absolute" inset=0 display="flex" flex-direction="column"
      background-color="photo.backdrop" color-scheme="dark" testId="photo"
      header display="flex" align-items="center" justify-content="flex-end" padding="8px 16px"
        button id="close" press=close aria-label="Close" testId="photo-close"
          image "symbol:close" color="photo.control"
      scroll id="photo" -exact-max-zoom=4 flex=1 min-height=0
        column width="100%" height="100%" position="relative"
          image url aria-label="" position="absolute" inset=0 width="100%" height="100%" object-fit="contain"
          image fullSize(url) aria-label="Full-size image" position="absolute" inset=0 width="100%" height="100%"
            object-fit="contain" testId="photo-full"

// To Watch or Favorites (`list` is the route's name, which is also the API's):
// sorted by the server, filtered here by kind (and on To Watch by release), each
// row a link to its title.
component SavedListScreen
  props
    navKey: string
    list: string
  state sort = "added"
  state kind = "all"
  state release = "all"
  state services = "all"
  state tag = ""
  resource saved = savedList(list, sort) as shape SavedList
  derive shown = current(saved) ? shownEntries(saved.titles, kind, release, services, tag) : []
  derive notes = current(saved) ? savedNotes(saved, release, services) : ""
  // The services filter shows once services are chosen; the tag filter once a
  // title is tagged, or while one is picked.
  derive byServices = list == "watchlist" and current(saved) and servicesState(saved) == "chosen"
  derive tags = current(saved) ? listTags(saved.titles) : []

  action pickSort(s: string)
    sort = s
  action pickKind(k: string)
    kind = k
  action pickRelease(r: string)
    release = r
  action pickServices(s: string)
    services = s
  action pickTag(t: string)
    tag = t
  action retry
    refresh saved

  view
    column navigationKey=navKey navigationScroll=`list-${list}` position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
        text listName(list) role="heading" aria-level=2 testId="list-title"
        button popovertarget=`list-sort-menu-${list}` aria-label="Sort" testId="list-sort"
          image "symbol:sort" color="accent"
        column id=`list-sort-menu-${list}` popover="auto" role="menu" aria-label="Sort by"
          for o in ["added", "rating"] key=o
            button press=pickSort(o) role="menuitemradio" aria-checked=(sort == o)
              popovertarget=`list-sort-menu-${list}` popovertargetaction="hide" testId=`list-sort-${o}`
              text (o == "added" ? "Added" : "Rating")
      if failed(saved)
        EmptyState(symbol="symbol:alert", title=`Can’t Load ${listName(list)}`, message="The server didn’t answer.")
          button press=retry testId="list-retry"
            text "Try Again"
      else if not current(saved)
        progress aria-label="Loading" testId="list-loading"
      else if saved.titles.length == 0
        if list == "favorites"
          EmptyState(symbol="symbol:star", title="No Favorites Yet", message="Favorite a movie or TV show and it will be listed here.")
        else
          EmptyState(symbol="symbol:bookmark", title="Nothing Saved Yet", message="Add a movie or TV show to To Watch and it will be listed here.")
      else
        list id=`list-${list}` testId="list-titles" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          section
            row flex-wrap="wrap" background-color="surface.card"
              text "Show" flex=1
              select value=kind change=pickKind aria-label="Show" testId="list-show" min-width=0
                for k in ["all", "movie", "tv"] key=k
                  option `${listKindLabel(k)} (${shownEntries(saved.titles, k, release, services, tag).length})` value=k
            if byServices
              row flex-wrap="wrap" background-color="surface.card"
                text "Available" flex=1
                select value=services change=pickServices aria-label="Available" testId="list-services" min-width=0
                  for f in ["all", "mine"] key=f
                    option `${servicesFilterLabel(f)} (${shownEntries(saved.titles, kind, release, f, tag).length})` value=f
            if list == "watchlist"
              row flex-wrap="wrap" background-color="surface.card"
                text "Release" flex=1
                select value=release change=pickRelease aria-label="Release" testId="list-release" min-width=0
                  for r in ["all", "out_now", "coming_soon"] key=r
                    option `${releaseFilterLabel(r)} (${shownEntries(saved.titles, kind, r, services, tag).length})` value=r
            if list == "watchlist" and (tags.length > 0 or tag != "")
              row flex-wrap="wrap" background-color="surface.card"
                text "Tag" flex=1
                select value=tag change=pickTag aria-label="Tag" testId="list-tag" min-width=0
                  option `Any (${shownEntries(saved.titles, kind, release, services, "").length})` value=""
                  for g in (tags.includes(tag) or tag == "" ? tags : [tag].concat(tags)) key=g
                    option `#${g} (${shownEntries(saved.titles, kind, release, services, g).length})` value=g
          section
            for e in shown key=`${e.kind}-${e.id}`
              ListRow(testId=`saved-${e.kind}-${e.id}`, href=titlePath(e.kind, e.id), picture=text(e.poster_url), label=e.title,
                detail=`${kindName(e.kind)} · ${match e.year { case some(y) => y, case none => "TBA" }}`, notes=entryNotes(e))
            if shown.length == 0
              text emptyListMessage(kind, release, services, tag) color="text.muted" testId="list-empty"
            footer
              text notes testId="list-notes"

// Every watched movie and show, however it was marked, as the web's /watched.
component WatchedScreen
  props
    navKey: string
  state sort = "recent"
  state kind = "all"
  state source = "any"
  resource watched = watchedList(sort) as shape WatchedList
  derive shown = current(watched) ? shownWatched(watched.titles, kind, source) : []
  derive notes = current(watched) ? watchedNotesAbout(shown, sort, text(watched.stale_since)) : ""

  action pickSort(s: string)
    sort = s
  action pickKind(k: string)
    kind = k
  action pickSource(s: string)
    source = s
  action retry
    refresh watched

  view
    column navigationKey=navKey navigationScroll="list-watched" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
        text "Watched" role="heading" aria-level=2 testId="list-title"
        button popovertarget="list-sort-menu-watched" aria-label="Sort" testId="list-sort"
          image "symbol:sort" color="accent"
        column id="list-sort-menu-watched" popover="auto" role="menu" aria-label="Sort by"
          for o in ["recent", "title"] key=o
            button press=pickSort(o) role="menuitemradio" aria-checked=(sort == o)
              popovertarget="list-sort-menu-watched" popovertargetaction="hide" testId=`list-sort-${o}`
              text (o == "recent" ? "Last Watched" : "Title")
      if failed(watched)
        EmptyState(symbol="symbol:alert", title="Can’t Load Watched", message="The server didn’t answer.")
          button press=retry testId="list-retry"
            text "Try Again"
      else if not current(watched)
        progress aria-label="Loading" testId="list-loading"
      else if watched.titles.length == 0
        EmptyState(symbol="symbol:checkmark", title="Nothing Watched Yet", message="Mark a movie, show, season or episode watched, or let Seen on Apple TV mark what plays.")
      else
        list id="list-watched" testId="list-watched" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          section
            row flex-wrap="wrap" background-color="surface.card"
              text "Show" flex=1
              select value=kind change=pickKind aria-label="Show" testId="list-show" min-width=0
                for k in ["all", "movie", "tv"] key=k
                  option `${listKindLabel(k)} (${shownWatched(watched.titles, k, source).length})` value=k
            row flex-wrap="wrap" background-color="surface.card"
              text "Marked" flex=1
              select value=source change=pickSource aria-label="Marked" testId="list-marked" min-width=0
                for s in ["any", "manual", "apple_tv"] key=s
                  option `${sourceLabel(s)} (${shownWatched(watched.titles, kind, s).length})` value=s
          section
            for t in shown key=`${t.kind}-${t.id}`
              ListRow(testId=`watched-${t.kind}-${t.id}`, href=titlePath(t.kind, t.id), picture=text(t.poster_url), label=watchedTitle(t),
                detail=(t.title == none ? `${kindName(t.kind)} · Details unavailable` : `${kindName(t.kind)} · ${match t.year { case some(y) => y, case none => "TBA" }}`),
                notes=watchedNotes(t))
            if shown.length == 0
              text `No ${listKindWord(kind)} ${source == "manual" ? "marked watched by hand" : source == "apple_tv" ? "marked watched from the Apple TV" : "watched"}.` color="text.muted" testId="list-empty"
            footer
              text notes testId="list-notes"

// A row on a list: poster, title, kind and year, then a line of notes (a release
// to come, a score, how it was watched), linking to the title.
component ListRow
  props
    testId: string
    href: string
    picture: string
    label: string
    detail: string
    notes: string
  view
    link href=href display="flex" align-items="center" gap=12 testId=testId background-color="surface.page"
      Thumb(url=picture)
      column flex=1 min-width=0 gap=2
        text label
        text detail font="-exact-footnote" color="text.muted"
        if notes != ""
          text notes font="-exact-footnote" color="mark.watched" testId=`${testId}-notes`
      image "symbol:forward-chevron" color="text.muted"
// Seen on Apple TV, as the web's /playback page: whether Home Assistant is
// followed, shows waiting on a choice of TMDB show or movie, and what played.
fn civilDays(y: number, m: number, d: number): number = eraDays(m <= 2 ? y - 1 : y, m, d)
fn eraDays(y: number, m: number, d: number): number = floor(y / 400) * 146097 + yearDays(y - floor(y / 400) * 400, m, d) - 719468
fn yearDays(yoe: number, m: number, d: number): number = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + floor((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
fn part(s: string, from: number, to: number): number = numberOf(s.slice(from, to))
// An RFC 3339 instant in UTC ("2026-11-16T14:46:31.03Z"), as epoch milliseconds.
fn instant(s: string): number = (civilDays(part(s, 0, 4), part(s, 5, 7), part(s, 8, 10)) * 86400 + part(s, 11, 13) * 3600 + part(s, 14, 16) * 60 + part(s, 17, 19)) * 1000
fn appName(a: string): string = a == "infuse" ? "Infuse" : "TV app"
fn noun(k: string): string = k == "movie" ? "movie" : "show"
fn played(d: Detection): string = d.kind == "movie" ? d.title : `${d.show_title} S${d.season} E${d.episode}`
fn statusName(s: string): string = s == "watching" ? "Watching" : s == "marked" ? "Marked watched" : s == "needs_confirmation" ? "Needs confirmation" : s == "no_match" ? "No TMDB match" : "Ignored"
fn progressOf(d: Detection): number = max(d.playing_seconds, match d.max_position { case some(p) => p, case none => 0 })
fn percentText(d: Detection): string = match d.duration {
  case some(n) => n > 0 ? `${min(100, floor(progressOf(d) * 100 / n))}% played` : "",
  case none => "" }
// "media_player.living_room_appletv" as "living room appletv".
fn playerName(id: string): string = id.replaceAll("media_player.", "").replaceAll("_", " ")
fn yearText(c: Candidate): string = match c.year { case some(y) => ` (${y})`, case none => "" }
fn pendingKey(p: PendingShow): string = `${p.app}-${p.show_key}`
fn waiting(p: PendingShow): string = `${match p.note { case some(n) => `${n}.`, case none => "" }}${p.episodes.length > 0 ? ` Waiting: ${p.episodes.join(", ")}.` : ""}`.trim()
fn liveText(l: LiveStatus): string = (l.state == "not_configured" ? "Home Assistant isn’t set up on the server, so nothing is marked automatically."
  : l.state == "connecting" ? "Connecting to Home Assistant…"
  : l.state == "connected" ? "Following Home Assistant live: episodes and movies are marked as soon as they’re watched."
  : `Disconnected from Home Assistant: ${text(l.error)}. Retrying; meanwhile its history is read at least every 5 minutes.`)
fn syncText(s: SyncStatus): string = s.state == "failed" ? `Couldn’t read Home Assistant’s history: ${text(s.error)}. Episodes and movies already played are still marked.` : ""

component PlaybackScreen
  props
    navKey: string
  state aimedKey = ""
  state aimedApp = ""
  state aimedKind = ""
  state aimedShow = ""
  state aimedTitle = ""
  state aimedId = 0
  state aimedName = ""
  state typed = ""
  resource p = playback() as shape Playback
  mutation decided as shape Playback refreshes p

  action again
    refresh p
  action aim(s: PendingShow)
    aimedKey = pendingKey(s)
    aimedApp = s.app
    aimedKind = s.kind
    aimedShow = s.show_key
    aimedTitle = s.show_title
  action choose(s: PendingShow, c: Candidate)
    aim(s)
    aimedId = c.id
    aimedName = `${c.name}${yearText(c)}`
    showModal("use-candidate")
  action askId(s: PendingShow)
    aim(s)
    typed = ""
    showModal("use-id")
  action askIgnore(s: PendingShow)
    aim(s)
    showModal("ignore-show")
  action editId(v: string)
    typed = v
  action use
    send decided = decidePlayback(aimedApp, aimedKind, aimedShow, aimedId)
  action useTyped
    match parseNumber(typed.trim())
      case some(n)
        send decided = decidePlayback(aimedApp, aimedKind, aimedShow, n)
      case none
        typed = ""
  action ignore
    send decided = ignorePlayback(aimedApp, aimedKind, aimedShow)

  view
    column navigationKey=navKey navigationScroll="playback" position="absolute" inset=0
      display="flex" flex-direction="column" background-color="surface.page"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text "Seen on Apple TV" role="heading" aria-level=2 testId="playback-title"
      if failed(p)
        EmptyState(symbol="symbol:alert", title="Can’t Load Playback", message="The server didn’t answer.")
          button press=again testId="playback-retry"
            text "Try Again"
      else if not current(p)
        progress aria-label="Loading" testId="playback-loading"
      else if p.live.state == "not_configured"
        EmptyState(symbol="symbol:sf/appletv", title="Home Assistant Isn’t Set Up", message="Set HA_URL and HA_TOKEN on the server and restart it to mark what plays on the Apple TV.")
          text "" testId="playback-not-configured"
      else
        list id="playback" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
          section
            text liveText(p.live) testId="playback-live" background-color="surface.card"
              color=(p.live.state == "disconnected" ? "mark.favorite" : "text.primary")
            if syncText(p.status) != ""
              text syncText(p.status) testId="playback-sync" color="mark.favorite" background-color="surface.card"
            if p.unreadable
              text "The playback history couldn’t be read from the database." testId="playback-unreadable" color="mark.favorite" background-color="surface.card"
            if failed(decided) and not pending(decided)
              text "Couldn’t save your choice. Try again." testId="decide-error" color="mark.favorite" background-color="surface.card"
          for s in p.pending key=pendingKey(s)
            section testId=`pending-${pendingKey(s)}`
              header
                text `${s.show_title} · ${s.kind == "movie" ? "Movie in " : ""}${appName(s.app)}`
              match s.candidates
                case some(cs)
                  for c in cs key=`${c.id}`
                    button press=choose(s, c) testId=`candidate-${pendingKey(s)}-${c.id}` background-color="surface.card"
                      display="flex" flex-direction="column" align-items="flex-start" gap=2
                      text `${c.name}${yearText(c)}`
                      text text(c.overview) font="-exact-footnote" color="text.muted"
                  if cs.length == 0
                    text `TMDB found no ${noun(s.kind)}s by that name.` color="text.muted" background-color="surface.card"
                case none
                  text `Couldn’t search TMDB right now. You can still enter the ${noun(s.kind)}’s TMDB ID.` color="mark.favorite" background-color="surface.card"
              button press=askId(s) testId=`enter-id-${pendingKey(s)}` background-color="surface.card"
                text "Enter a TMDB ID…"
              button press=askIgnore(s) destructive=true testId=`ignore-${pendingKey(s)}` background-color="surface.card"
                text `Ignore This ${s.kind == "movie" ? "Movie" : "Show"}`
              footer
                text waiting(s)
          section
            header
              text "Recently Played"
            if p.recent.length == 0
              text "Nothing yet." color="text.muted" testId="playback-empty" background-color="surface.card"
            for d in p.recent key=`${d.app}-${d.item_key}`
              column gap=2 testId=`played-${d.item_key}` background-color="surface.card"
                text played(d)
                text statusName(d.status) font="-exact-footnote"
                  color=(d.status == "marked" ? "mark.watched" : "text.muted")
                text font="-exact-footnote" color="text.muted"
                  time datetime=instant(d.last_seen) format="relative"
                  text ` · ${appName(d.app)}${percentText(d) == "" ? "" : ` · ${percentText(d)}`}`
                if text(d.note) != ""
                  text text(d.note) font="-exact-footnote" color="text.muted"
            footer
              text `${p.players.length > 0 ? `Home Assistant reports what plays on ${p.players.map(x => playerName(x)).join(", ")}. ` : ""}Episodes are marked once 90% has played, or 80% if you moved on to a later one; movies once 90% has played.`
      dialog id="use-candidate" role="alertdialog" aria-label=`Use ${aimedName}?`
        text (aimedKind == "movie" ? `${aimedTitle} is marked watched as ${aimedName}.` : `Episodes of ${aimedTitle} that played are marked watched in ${aimedName}, and later ones are matched to it.`)
        button press=use commandfor="use-candidate" command="close" testId="use-confirm"
          text `Use This ${aimedKind == "movie" ? "Movie" : "Show"}`
        button commandfor="use-candidate" command="close" testId="use-cancel"
          text "Cancel"
      dialog id="use-id" role="alertdialog" aria-label=`TMDB ${aimedKind == "movie" ? "Movie" : "TV"} ID for ${aimedTitle}`
        text (aimedKind == "movie" ? "The number in its TMDB address, like the 105 in themoviedb.org/movie/105." : "The number in its TMDB address, like the 1396 in themoviedb.org/tv/1396.")
        input value=typed input=editId inputmode="numeric" placeholder=(aimedKind == "movie" ? "105" : "1396") aria-label="TMDB ID" testId="tmdb-id"
        button press=useTyped disabled=(parseNumber(typed.trim()) == none) commandfor="use-id" command="close" testId="use-id-confirm"
          text "Use"
        button commandfor="use-id" command="close"
          text "Cancel"
      dialog id="ignore-show" role="alertdialog" aria-label=`Ignore ${aimedTitle}?`
        text `What played of it stays unmarked, and it won’t be asked about again.`
        button press=ignore destructive=true commandfor="ignore-show" command="close" testId="ignore-confirm"
          text "Ignore"
        button commandfor="ignore-show" command="close" testId="ignore-cancel"
          text "Cancel"

// What credits is, where its data comes from (with the notice TMDB's terms ask
// for) and how Home Assistant is doing, as the web's About page shows. The
// credits never wait on the server; only the Home Assistant line does.
component AboutScreen
  props
    navKey: string
  resource p = playback() as shape Playback
  action again
    refresh p
  view
    column navigationKey=navKey navigationScroll="about" position="absolute" inset=0
      display="flex" flex-direction="column" background-color="surface.page"
      header display="flex" align-items="center" padding="8px 16px" background-color="surface.page"
        text "About" role="heading" aria-level=2 testId="about-title"
      list id="about" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="surface.page"
        section
          text "credits looks up movies, TV shows and people, and shows who made them." background-color="surface.card"
        section
          header
            text "Data Sources"
          link href="https://www.themoviedb.org/" testId="about-tmdb" background-color="surface.card"
            text "TMDB"
          text "This product uses the TMDB API but is not endorsed or certified by TMDB."
            background-color="surface.card" testId="about-tmdb-notice"
          link href="https://www.omdbapi.com/" testId="about-omdb" background-color="surface.card"
            text "Ratings via the OMDb API"
          link href="https://www.imdb.com" testId="about-imdb" background-color="surface.card"
            text "Episode ratings OMDb lacks: information courtesy of IMDb. Used with permission."
          link href="https://www.justwatch.com/" testId="about-justwatch" background-color="surface.card"
            text "Where to watch data by JustWatch, via TMDB"
        section
          header
            text "Home Assistant"
          if failed(p)
            text "Couldn’t load Home Assistant’s status: the server didn’t answer." color="mark.favorite"
              background-color="surface.card" testId="about-ha-failed"
            button press=again testId="about-ha-retry" background-color="surface.card"
              text "Try Again"
          else if not current(p)
            progress aria-label="Loading" testId="about-ha-loading"
          else
            text liveText(p.live) testId="about-ha" background-color="surface.card"
              color=(p.live.state == "disconnected" ? "mark.favorite" : "text.primary")
            if p.live.state != "not_configured"
              link href=path("playback") testId="about-playback" background-color="surface.card"
                text "Seen on Apple TV"
