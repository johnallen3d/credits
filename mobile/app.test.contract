test "a To Watch title's recommended-by tags are added, offered and removed"
  at "/movie/1"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/movie/1" with 200 {"kind":"movie","id":1,"title":"Soon","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false},"sources":["jazzy"]}
  answer fetch "https://credits.jallen7usa.com/api/watchlist/sources" with 200 {"sources":["podcast","Jazzy","sam"]}
  clock settle
  expect tree has "source-jazzy"
  expect tree has "source-suggest-podcast"
  expect tree missing "source-suggest-Jazzy"
  expect disabled "source-add"
  answer fetch "https://credits.jallen7usa.com/api/movie/1/watchlist/sources" with 200 {"sources":["jazzy","Sam","a-friend"]}
  answer fetch "https://credits.jallen7usa.com/api/movie/1" with 200 {"kind":"movie","id":1,"title":"Soon","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false},"sources":["jazzy","Sam","a-friend"]}
  type "source-draft" "#Sam a-friend"
  tap "source-add"
  clock data
  clock settle
  expect tree has "source-Sam"
  expect tree has "source-a-friend"
  expect text "source-draft" == ""
  expect tree missing "source-suggest-sam"
  answer fetch "https://credits.jallen7usa.com/api/movie/1/watchlist/sources" with 200 {"sources":["Sam","a-friend"]}
  answer fetch "https://credits.jallen7usa.com/api/movie/1" with 200 {"kind":"movie","id":1,"title":"Soon","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false},"sources":["Sam","a-friend"]}
  tap "source-remove-jazzy"
  clock data
  clock settle
  expect tree missing "source-jazzy"
  expect tree missing "source-error"

