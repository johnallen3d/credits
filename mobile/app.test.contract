  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
  clock data
  expect tree has "where-none"
  expect tree missing "where-unavailable"

test "a title in theaters with no offers says so"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":true,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
