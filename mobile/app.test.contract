test "stale offers say when they were listed, and unreadable services say none are highlighted"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"stale","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[{"kind":"stream","providers":[{"id":8,"name":"Netflix","logo_url":null,"mine":false}]}],"fetched_at":"2026-11-02T10:00:00Z","my_services":"unreadable"}}
  clock data
  expect text "where-stale" == "Couldn’t refresh where to watch; showing what was listed on Nov 2, 2026."
  expect tree has "services-unreadable"
  expect tree missing "where-mine"

