test "search starts empty"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  expect tree has "app"
  expect tree has "search"
  expect tree missing "recent"

test "start screen lists recently viewed titles"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"movie","id":603,"name":"The Matrix","year":"1999","image_url":null},{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  expect tree has "recent-movie-603"
  expect tree has "recent-person-6384"

test "the theme starts as Rosé Pine and survives a relaunch"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  expect state theme == "rose-pine"
  tap "theme"
  tap "theme-tokyo-night"
  expect state theme == "tokyo-night"
  reload
  expect state theme == "tokyo-night"

test "marking a movie a favorite shows the server's new marks"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/movie/603/favorite" with 200 {"marks":{"to_watch":true,"favorite":true,"watched":false}}
  expect tree has "mark-favorite"
  expect tree missing "favorite-badge"
  tap "mark-favorite"
  clock data
  expect tree has "favorite-badge"
  expect tree missing "mark-error"

test "a mark the server refuses says so"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false}}
  fail fetch "https://credits.jallen7usa.com/api/movie/603/watched"
  tap "mark-watched"
  clock data
  expect tree has "mark-error"
  expect refusal "marked"

test "marking a season watched unblurs and marks its episodes"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":false,"seasons":[],"episodes":[]}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1/watched" with 200 {"state":"read","show":false,"seasons":[1],"episodes":[]}
  expect text "season-state" == "Season not watched"
  expect text "mark-episode-1" == "Mark Watched"
  tap "mark-season"
  clock data
  expect text "season-state" == "Season watched"
  expect text "mark-episode-2" == "Watched"
  expect disabled "mark-episode-2"

test "marking one episode watched leaves the others"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":false,"seasons":[],"episodes":[]}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1/episode/1/watched" with 200 {"state":"read","show":false,"seasons":[],"episodes":[{"season":1,"number":1}]}
  tap "mark-episode-1"
  clock data
  expect text "mark-episode-1" == "Watched"
  expect text "mark-episode-2" == "Mark Watched"
  expect enabled "mark-episode-1"

test "a season watched with the whole show can't be unmarked here"
  at "/tv/95396/season/1"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396" with 200 {"kind":"tv","id":95396,"title":"Severance","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/tv/95396/season/1" with 200 {"show_title":"Severance","number":1,"name":"Season 1","episodes":[{"number":1,"title":"Good News About Hell"},{"number":2,"title":"Half Loop"}],"watched":{"show":true,"seasons":[],"episodes":[]}}
  expect text "season-state" == "Watched with the whole show"
  expect disabled "mark-season"
  expect text "mark-episode-1" == "Watched"

test "where to watch groups the offers and marks the user's services"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"fresh","link":"https://www.themoviedb.org/movie/603-the-matrix/watch?locale=US","offers":[{"kind":"stream","providers":[{"id":8,"name":"Netflix","logo_url":null,"mine":true},{"id":2528,"name":"YouTube TV","logo_url":null,"mine":false}]},{"kind":"rent","providers":[{"id":10,"name":"Amazon Video","logo_url":null,"mine":false}]},{"kind":"buy","providers":[{"id":10,"name":"Amazon Video","logo_url":null,"mine":false}]}],"fetched_at":"2026-11-02T10:00:00Z","my_services":"chosen"}}
  clock data
  expect tree has "offers-stream"
  expect tree has "offers-rent"
  expect tree has "offers-buy"
  expect tree has "provider-8-mine"
  expect tree has "provider-2528"
  expect text "where-mine" == "On your services: Netflix"
  expect tree has "where-link"
  expect tree missing "where-stale"
  expect tree missing "services-not-chosen"

test "where to watch says when it couldn't be loaded rather than showing nothing"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":null,"poster_url":null,"backdrop_url":null,"ratings":{"preferred":null},"cast":[],"season_list":null,"marks":{"to_watch":false,"favorite":false,"watched":false},"in_theaters":false,"where_to_watch":{"region":"US","state":"unavailable","link":null,"offers":[],"fetched_at":null,"my_services":"chosen"}}
  clock data
  expect tree has "where-unavailable"
  expect tree missing "where-none"
  expect tree missing "where-link"

