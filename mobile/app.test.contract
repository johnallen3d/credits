  expect text "kind-all" == "All 3"
  expect text "kind-movie" == "Movies 2"
  expect text "kind-tv" == "TV 1"
  tap "kind-tv"
  expect tree has "Acting-tv-1"
  expect tree missing "Acting-movie-603"
  expect tree missing "Production-movie-9"
  tap "kind-movie"
  expect tree missing "Acting-tv-1"
  expect tree has "Production-movie-9"
  tap "kind-all"
  expect tree has "Acting-tv-1"
  expect tree has "Acting-movie-603"

