test "the browse menu opens To Watch, with its filters counting and a release to come"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/1" with 200 {"kind":"movie","id":1,"title":"Soon","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":true,"favorite":false,"watched":false},"sources":["a-podcast","jazzy"]}
  answer fetch "https://credits.jallen7usa.com/api/watchlist?sort=added" with 200 {"sort":"added","release_unknown":1,"titles":[{"kind":"movie","id":1,"title":"Soon","year":"2026","next_release":{"kind":"digital","date":"2026-12-05","upcoming":true},"release_status":"coming_soon"},{"kind":"tv","id":2,"title":"Out","year":"2011","release_status":"out_now","sources":["Sam"]},{"kind":"movie","id":3,"title":"Unknown","year":null}]}
  tap "menu"
  clock settle
  tap "open-watchlist"
  clock settle
  expect text "list-title" == "To Watch"
