  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":null,"year":"1999","genres":[],"runtime_minutes":136,"poster_url":null,"backdrop_url":null,"ratings":{"state":"fresh","unavailable_reason":null,"preferred":{"source":"rotten_tomatoes","score":83,"scale":100},"fetched_at":"2026-11-16T08:00:00Z"},"cast":[],"season_list":[],"marks":{"to_watch":false,"favorite":true,"watched":false},"metadata":{"state":"fresh","fetched_at":"2026-11-16T08:00:00Z"}}
  tap "recent-movie-603"
