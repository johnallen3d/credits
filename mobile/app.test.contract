test "a title shows each score as a ring, the preferred one first"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":["Action"],"ratings":{"preferred":{"source":"rotten_tomatoes","score":83,"scale":100,"votes":null},"others":[{"source":"imdb","score":8.7,"scale":10,"votes":2284373}]},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  clock data
  expect tree has "ratings"
  expect text "score-rotten_tomatoes" == "83Rotten TomatoesFresh"
  expect text "score-imdb" == "87IMDbIMDb8.7/10 · 2,284,373 votes"

