test "now playing lists movies with their dates and ratings, linking to their screens"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/now-playing?page=1" with 200 {"page":1,"total_pages":2,"titles":[{"id":603,"title":"The Matrix","release_date":"1999-03-31","poster_url":null,"rating":{"source":"imdb","score":8.7,"scale":10}},{"id":604,"title":"Unrated","release_date":null,"poster_url":null,"rating":null}]}
  answer fetch "https://credits.jallen7usa.com/api/now-playing?page=2" with 200 {"page":2,"total_pages":2,"titles":[{"id":605,"title":"The Matrix Revolutions","release_date":"2003-11-05","poster_url":null,"rating":null}]}
  tap "browse"
  tap "browse-now-playing"
  expect text "releases-title" == "Now Playing"
  expect tree has "release-603"
  expect tree has "release-604"
  expect tree missing "release-605"
  tap "more"
  expect tree has "release-605"
  expect tree missing "more"
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  tap "release-603"
  expect text "title" == "The Matrix"

test "coming soon says so when the server doesn't answer"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  fail fetch "https://credits.jallen7usa.com/api/coming-soon?page=1"
  tap "browse"
  tap "browse-coming-soon"
  expect text "releases-title" == "Coming Soon"
  expect tree missing "title-releases"

test "my services opens from the start screen's menu, grouped, with the chosen first"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":8,"name":"Netflix","logo_url":null}],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":true,"group":"mine"},{"id":337,"name":"Disney Plus","logo_url":null,"chosen":false,"group":"popular"},{"id":2,"name":"Apple TV Store","logo_url":null,"chosen":false,"group":"more"}],"state":"fresh","complete":true,"fetched_at":null}
  tap "browse"
  tap "open-services"
  clock settle
  clock data
  expect tree has "services-title"
  expect text "services-status" == "Your services: Netflix."
  expect tree has "service-8"
  expect tree has "service-337"
  expect tree has "service-2"
  expect tree missing "services-unavailable"

test "flipping a switch saves the choice and shows the new services"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"},{"id":337,"name":"Disney Plus","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  clock data
  expect text "services-status" == "No services chosen yet."
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":337,"name":"Disney Plus","logo_url":null}],"options":[{"id":337,"name":"Disney Plus","logo_url":null,"chosen":true,"group":"mine"},{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  type "service-337" "true"
  clock data
  expect text "services-status" == "Your services: Disney Plus."
  expect tree missing "services-error"

test "a save that fails says so"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":false,"group":"popular"}],"state":"fresh","complete":true,"fetched_at":null}
  clock data
  fail fetch "https://credits.jallen7usa.com/api/services"
  type "service-8" "true"
  clock data
  expect tree has "services-error"
  expect text "services-status" == "No services chosen yet."

test "services that can't be loaded offer to try again"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  fail fetch "https://credits.jallen7usa.com/api/services"
  clock data
  expect tree has "services-retry"
  pass fetch "https://credits.jallen7usa.com/api/services"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[],"options":[],"state":"fresh","complete":true,"fetched_at":null}
  tap "services-retry"
  clock data
  expect tree missing "services-retry"
  expect text "services-status" == "No services chosen yet."

test "without TMDB's list only the chosen services are listed, and it says why"
  at "/services"
  fail fetch "https://credits.jallen7usa.com/api/recent"
  answer fetch "https://credits.jallen7usa.com/api/services" with 200 {"region":"US","chosen":[{"id":8,"name":"Netflix","logo_url":null}],"options":[{"id":8,"name":"Netflix","logo_url":null,"chosen":true,"group":"mine"}],"state":"unavailable","complete":false,"fetched_at":null}
  clock data
  expect tree has "services-unavailable"
  expect tree missing "services-partial"
  expect tree has "service-8"
test "a movie in theaters shows its release dates, rating and showtimes"
  at "/movie/7"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/7" with 200 {"kind":"movie","id":7,"title":"Opening Night","genres":[],"ratings":{"preferred":null},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false},"releases":{"region":"US","certification":"PG-13","dates":[{"kind":"theatrical","date":"2026-11-06","upcoming":false},{"kind":"digital","date":"2027-01-20","upcoming":true}]},"in_theaters":true,"showtimes_url":"https://www.fandango.com/search?q=Opening%20Night"}
  expect tree has "in-theaters"
  expect tree has "showtimes"
  expect tree has "release-theatrical"
  expect tree has "release-digital"
  expect tree has "certification"

test "a movie without dates or theaters shows none of them"
  at "/movie/8"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/8" with 200 {"kind":"movie","id":8,"title":"Old Film","genres":[],"ratings":{"preferred":null},"cast":[],"marks":{"to_watch":false,"favorite":false,"watched":false},"releases":null,"in_theaters":false,"showtimes_url":null}
  expect tree has "title"
  expect tree missing "in-theaters"
  expect tree missing "showtimes"
  expect tree missing "title-releases"

test "a movie shows its key crew and opens the full cast and crew"
  at "/movie/603"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603/credits" with 200 {"kind":"movie","id":603,"title":"The Matrix","year":"1999","cast":[{"person_id":6384,"name":"Keanu Reeves","role":"Neo","episode_count":null,"profile_url":null}],"crew":[{"name":"Directing","people":[{"person_id":9340,"name":"Lana Wachowski","role":"Director","episode_count":null,"profile_url":null}]}],"metadata":{}}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"marks":{"to_watch":false,"favorite":false,"watched":false},"key_crew":[{"role":"director","people":[{"person_id":9340,"name":"Lana Wachowski"},{"person_id":9339,"name":"Lilly Wachowski"}]}],"cast":[{"person_id":6384,"name":"Keanu Reeves","role":"Neo"}],"cast_total":36,"crew_total":120}
  clock data
  expect text "crew-director" == "Directed byLana Wachowski, Lilly Wachowski"
  expect text "full-credits" == "Full Cast & Crew36 cast, 120 crew"
  tap "full-credits"
  clock data
  clock settle
  expect text "credits-title" == "The Matrix: Cast & Crew"
  expect text "cast-6384" == "Keanu Reevesas Neo"
  expect text "Directing-9340" == "Lana WachowskiDirector"

test "a show's actors keep their episode counts hidden while its crew show them"
  at "/tv/1396/credits"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396/credits" with 200 {"kind":"tv","id":1396,"title":"Breaking Bad","cast":[{"person_id":17419,"name":"Bryan Cranston","role":"Walter White","episode_count":null}],"crew":[{"name":"Directing","people":[{"person_id":29779,"name":"Michelle MacLaren","role":"Director","episode_count":11}]}],"metadata":{}}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396" with 200 {"kind":"tv","id":1396,"title":"Breaking Bad","genres":[],"ratings":{},"marks":{"to_watch":false,"favorite":false,"watched":false},"key_crew":[],"cast":[],"cast_total":0,"crew_total":0}
  clock data
  expect text "cast-17419" == "Bryan Cranstonas Walter White"
  expect text "Directing-29779" == "Michelle MacLarenDirector · 11 episodes"

test "cast and crew that can't load say so"
  at "/tv/1396/credits"
  fail fetch "https://credits.jallen7usa.com/api/tv/1396/credits"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[]}
  answer fetch "https://credits.jallen7usa.com/api/tv/1396" with 200 {"kind":"tv","id":1396,"title":"Breaking Bad","genres":[],"ratings":{},"marks":{"to_watch":false,"favorite":false,"watched":false},"key_crew":[],"cast":[],"cast_total":0,"crew_total":0}
  clock data
  expect tree missing "cast-17419"
  expect tree has "credits-retry"

test "a recently viewed person opens their page with photo, facts and credits"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  answer fetch "https://credits.jallen7usa.com/api/person/6384?sort=date" with 200 {"id":6384,"name":"Keanu Reeves","known_for":"Acting","biography":"Keanu was born in Beirut.\n\nHe grew up in Toronto.","birthday":"1964-09-02","deathday":null,"place_of_birth":"Beirut, Lebanon","profile_url":null,"known_for_titles":[{"kind":"movie","id":603,"title":"The Matrix","year":"1999","role":"Neo"}],"filmography":[{"department":"Acting","entries":[{"kind":"movie","id":603,"title":"The Matrix","year":"1999","role":"Neo"},{"kind":"tv","id":1,"title":"A Show","year":null,"role":"Self","episode_count":2}]},{"department":"Production","entries":[{"kind":"movie","id":9,"title":"A Film","year":"2020","role":"Producer"}]}],"sort":"date","sort_ratings":{"unrated":0}}
  tap "recent-person-6384"
  clock data
  expect text "person-name" == "Keanu Reeves"
  expect text "known-for" == "Known for Acting"
  expect text "born" == "Born Sep 2, 1964 in Beirut, Lebanon"
  expect tree missing "died"
  expect tree has "known-movie-603"
  expect tree has "Acting-tv-1"
  expect tree has "Production-movie-9"
  expect text "bio-0" == "Keanu was born in Beirut."
  expect tree missing "bio-1"
  tap "more"
  expect text "bio-1" == "He grew up in Toronto."
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","genres":[],"ratings":{},"cast":[{"person_id":6384,"name":"Keanu Reeves","role":"Neo"}],"marks":{"to_watch":false,"favorite":false,"watched":false}}
  tap "Acting-movie-603"
  clock data
  expect text "title" == "The Matrix"
  tap "title-cast-6384"
  clock data
  expect text "person-name" == "Keanu Reeves"

test "sorting a person's credits by rating shows each score"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  answer fetch "https://credits.jallen7usa.com/api/person/6384?sort=date" with 200 {"id":6384,"name":"Keanu Reeves","known_for_titles":[],"filmography":[{"department":"Acting","entries":[{"kind":"movie","id":603,"title":"The Matrix","year":"1999","role":"Neo"}]}],"sort":"date"}
  answer fetch "https://credits.jallen7usa.com/api/person/6384?sort=rating" with 200 {"id":6384,"name":"Keanu Reeves","known_for_titles":[],"filmography":[{"department":"Acting","entries":[{"kind":"movie","id":603,"title":"The Matrix","year":"1999","role":"Neo","rating":{"source":"rotten_tomatoes","score":83.0,"scale":100}}]}],"sort":"rating","sort_ratings":{"unrated":3}}
  tap "recent-person-6384"
  clock data
  expect tree has "no-bio"
  expect tree missing "score-movie-603"
  tap "sort-rating"
  clock data
  expect text "score-movie-603" == "83%"
  expect text "rating-note" == "Credits without a Rotten Tomatoes or IMDb score are listed last, newest first."

test "a person page the server can't answer says so"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"person","id":6384,"name":"Keanu Reeves"}]}
  fail fetch "https://credits.jallen7usa.com/api/person/6384?sort=date"
  tap "recent-person-6384"
  clock data
  expect text "person-name" == ""
  expect tree missing "loading"
  expect tree missing "known-for"
test "a title served stale from the cache says so, and its ratings note why they're missing"
  answer fetch "https://credits.jallen7usa.com/api/recent" with 200 {"recent":[{"kind":"movie","id":603,"name":"The Matrix","year":"1999","image_url":null}]}
  answer fetch "https://credits.jallen7usa.com/api/movie/603" with 200 {"kind":"movie","id":603,"title":"The Matrix","tagline":null,"overview":"Neo wakes up.","year":"1999","genres":["Action"],"runtime_minutes":136,"poster_url":null,"backdrop_url":null,"ratings":{"state":"unavailable","unavailable_reason":"provider_error","preferred":null,"fetched_at":null},"cast":[],"season_list":[],"marks":{"to_watch":null,"favorite":null,"watched":null},"metadata":{"state":"stale","fetched_at":"2026-10-16T08:00:00Z"}}
  tap "recent-movie-603"
  expect text "title" == "The Matrix"
  expect text "stale" == "TMDB isn’t responding, so this page shows details saved on Oct 16, 2026. They may be out of date."
  expect text "ratings-note" == "Ratings couldn’t be loaded right now."
  expect tree has "favorites-note"
  expect tree missing "score"

