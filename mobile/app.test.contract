  tap "candidate-tv-dark matter-196322"
  clock settle
  answer fetch "https://credits.jallen7usa.com/api/playback" with 200 {"live":{"state":"connected","since":"2026-11-16T14:46:31Z"},"status":{"state":"ok","at":"2026-11-16T14:46:31Z"},"players":[],"pending":[],"recent":[],"other":[],"unreadable":false}
